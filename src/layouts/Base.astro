---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object[];
}

const { title, description, canonical, schema = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = 'https://seoreading.uk';
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const year = new Date().getFullYear();

const navLinks = [
  { href: '/services/', label: 'Services', match: '/services' },
  { href: '/areas/', label: 'Areas', match: '/areas' },
  { href: '/industries/', label: 'Industries', match: '/industries' },
  { href: '/case-studies/', label: 'Case Studies', match: '/case-studies' },
  { href: '/about/', label: 'About', match: '/about' },
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SEO Reading" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="geo.region" content="GB-RDG" />
  <meta name="geo.placename" content="Reading, Berkshire" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  {schema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
    <!-- GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-190NG3QSFD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-190NG3QSFD');
    </script>
  </head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-brand focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">Skip to content</a>

  <header class="sticky top-0 z-40 transition-all duration-300" id="site-header">
    <!-- Gold accent line -->
    <div class="h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent" aria-hidden="true"></div>

    <div class="bg-white/95 backdrop-blur-md border-b border-border/40">
      <nav class="max-w-6xl mx-auto px-5 py-4 flex items-center justify-between transition-all duration-300" id="site-nav">
        <!-- Logo -->
        <a href="/" class="group flex items-baseline gap-1.5">
          <span class="text-[0.65rem] font-bold text-accent tracking-[0.18em] uppercase">SEO</span>
          <span class="text-[1.4rem] font-bold text-brand tracking-tight transition-colors group-hover:text-brand-light" style="font-family: var(--font-serif)">Reading</span>
        </a>

        <!-- Desktop nav -->
        <div class="hidden lg:flex items-center gap-8">
          {navLinks.map(({ href, label, match }) => (
            <a
              href={href}
              class:list={[
                'text-[0.9rem] font-medium transition-colors relative pb-1',
                currentPath.startsWith(match)
                  ? 'text-brand after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-accent after:rounded-full'
                  : 'text-text-muted hover:text-brand'
              ]}
            >{label}</a>
          ))}
          <a href="/contact/" class="btn btn-primary text-[0.85rem] py-2.5 px-5 relative overflow-hidden">
            <span class="relative z-10">Book a Consultation</span>
            <span class="shimmer absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full"></span>
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-lg hover:bg-surface transition-colors"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="burger-top" class="block w-5 h-[2px] bg-brand transition-all duration-300 origin-center"></span>
          <span id="burger-mid" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-300"></span>
          <span id="burger-bot" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-300 origin-center"></span>
        </button>
      </nav>
    </div>

    <!-- Mobile menu: glassmorphism slide-down -->
    <div
      id="mobile-menu"
      class="lg:hidden overflow-hidden transition-all duration-400 max-h-0 opacity-0"
      role="navigation"
      aria-label="Mobile navigation"
      style="backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); background: rgba(250, 247, 242, 0.95);"
    >
      <div class="max-w-5xl mx-auto px-5 py-6 flex flex-col gap-1">
        {navLinks.map(({ href, label, match }) => (
          <a
            href={href}
            class:list={[
              'block py-3 px-4 rounded-lg text-[0.95rem] font-medium transition-all duration-200',
              currentPath.startsWith(match)
                ? 'bg-white text-brand shadow-sm'
                : 'text-text-muted hover:bg-white hover:text-brand hover:shadow-sm'
            ]}
          >{label}</a>
        ))}
        <div class="mt-3 pt-3 border-t border-border/60">
          <a href="/contact/" class="btn btn-primary w-full text-center block">Book a Consultation</a>
        </div>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <footer class="bg-brand-dark text-white mt-20 relative overflow-hidden">
    <!-- Atmospheric elements -->
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-32 -right-32 w-64 h-64 rounded-full opacity-10 blur-[80px]" style="background: radial-gradient(circle, #D4AF37, transparent 70%);" aria-hidden="true"></div>

    <!-- Gold accent top -->
    <div class="h-[2px] bg-gradient-to-r from-transparent via-accent/50 to-transparent relative z-10" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-5 pt-14 pb-10 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
        <!-- Brand column -->
        <div class="md:col-span-4">
          <div class="flex items-baseline gap-1.5 mb-4">
            <span class="text-[0.6rem] font-bold text-accent tracking-[0.18em] uppercase">SEO</span>
            <span class="text-xl font-bold tracking-tight" style="font-family: var(--font-serif)">Reading</span>
          </div>
          <p class="text-sm text-gray-400 leading-relaxed max-w-xs">Search marketing consultancy based in Reading, Berkshire. We help Thames Valley businesses achieve prominence in Google and AI-powered search engines.</p>
          <div class="mt-5 flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Reading, Berkshire, UK
          </div>
        </div>

        <!-- Services column -->
        <div class="md:col-span-3">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Services</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li><a href="/services/" class="hover:text-white transition-colors duration-200">All Services</a></li>
            <li><a href="/technical-seo-reading/" class="hover:text-white transition-colors duration-200">Technical SEO</a></li>
            <li><a href="/seo-audit-reading/" class="hover:text-white transition-colors duration-200">SEO Audit</a></li>
            <li><a href="/ai-search-optimisation-reading/" class="hover:text-white transition-colors duration-200">AI Search Optimisation</a></li>
            <li><a href="/seo-pricing-reading/" class="hover:text-white transition-colors duration-200">Pricing</a></li>
          </ul>
        </div>

        <!-- Resources column -->
        <div class="md:col-span-2">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Explore</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li><a href="/free-seo-audit-reading/" class="hover:text-white transition-colors duration-200">Free Audit</a></li>
            <li><a href="/case-studies/" class="hover:text-white transition-colors duration-200">Case Studies</a></li>
            <li><a href="/areas/" class="hover:text-white transition-colors duration-200">Areas</a></li>
            <li><a href="/industries/" class="hover:text-white transition-colors duration-200">Industries</a></li>
            <li><a href="/tools/local-seo-checklist/" class="hover:text-white transition-colors duration-200">Local SEO Checklist</a></li>
            <li><a href="/tools/schema-generator/" class="hover:text-white transition-colors duration-200">Schema Generator</a></li>
            <li><a href="/tools/seo-roi-calculator/" class="hover:text-white transition-colors duration-200">SEO ROI Calculator</a></li>
          </ul>
        </div>

        <!-- Contact column -->
        <div class="md:col-span-3">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Contact</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li>
              <a href="mailto:hello@seoreading.uk" class="hover:text-white transition-colors duration-200 flex items-center gap-2">
                <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                hello@seoreading.uk
              </a>
            </li>
            <li><a href="/about/" class="hover:text-white transition-colors duration-200">About Us</a></li>
            <li><a href="/contact/" class="hover:text-white transition-colors duration-200">Get in Touch</a></li>
          </ul>
        </div>
      </div>

      <!-- Footer bottom -->
      <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
        <p>&copy; {year} SEO Reading. All rights reserved.</p>
        <div class="flex gap-5">
          <a href="/sitemap-index.xml" class="hover:text-gray-300 transition-colors">Sitemap</a>
          <a href="/llms.txt" class="hover:text-gray-300 transition-colors">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    // Mobile menu
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const burgerTop = document.getElementById('burger-top');
    const burgerMid = document.getElementById('burger-mid');
    const burgerBot = document.getElementById('burger-bot');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));

        if (!expanded) {
          menu.style.maxHeight = menu.scrollHeight + 'px';
          menu.style.opacity = '1';
          burgerTop?.classList.add('translate-y-[7px]', 'rotate-45');
          burgerMid?.classList.add('opacity-0', 'scale-0');
          burgerBot?.classList.add('-translate-y-[7px]', '-rotate-45');
        } else {
          menu.style.maxHeight = '0';
          menu.style.opacity = '0';
          burgerTop?.classList.remove('translate-y-[7px]', 'rotate-45');
          burgerMid?.classList.remove('opacity-0', 'scale-0');
          burgerBot?.classList.remove('-translate-y-[7px]', '-rotate-45');
        }
      });
    }

    // Header shrink on scroll
    const header = document.getElementById('site-header');
    const nav = document.getElementById('site-nav');
    if (header && nav) {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            if (window.scrollY > 60) {
              nav.classList.replace('py-4', 'py-2');
            } else {
              nav.classList.replace('py-2', 'py-4');
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }

    // Fade-up scroll observer
    const fadeObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          fadeObserver.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.fade-up').forEach(el => fadeObserver.observe(el));

    // Card spotlight tracking
    document.querySelectorAll('.card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
        (e.currentTarget as HTMLElement).style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
        (e.currentTarget as HTMLElement).style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
      });
    });

    // Animated counters
    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          const el = e.target as HTMLElement;
          const target = parseInt(el.dataset.count || '0', 10);
          const suffix = el.dataset.suffix || '';
          const prefix = el.dataset.prefix || '';
          const duration = 1800;
          const start = performance.now();

          function tick(now: number) {
            const elapsed = now - start;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 4);
            const current = Math.round(target * eased);
            el.textContent = prefix + current.toLocaleString() + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          counterObserver.unobserve(el);
        }
      });
    }, { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach(el => counterObserver.observe(el));
  </script>

<!-- Post-submit confirmation. On a static build Astro.url.searchParams is empty at
     runtime, so the ?sent=1 check has to happen client side or the visitor sees the
     same empty form and assumes the send failed. -->
<script is:inline>
  (function () {
    if (window.location.search.indexOf('sent=1') === -1) return;
    var run = function () {
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        var f = forms[i];
        if (!f.querySelector('[name="redirectTo"], [name="redirect"]')) continue;
        var box = document.createElement('div');
        box.setAttribute('role', 'status');
        box.style.cssText = 'border:1px solid currentColor;border-radius:8px;padding:1.25rem 1.5rem;margin:0 0 1.5rem;line-height:1.5';
        box.innerHTML = '<strong>Thanks, your message has been sent.</strong><br>We have received it and will be in touch.';
        f.parentNode.insertBefore(box, f);
        f.hidden = true;
      }
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
</body>
</html>
