---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object[];
}

const { title, description, canonical, schema = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = 'https://seoreading.uk';
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const year = new Date().getFullYear();

const navLinks = [
  { href: '/services/', label: 'Services', match: '/services' },
  { href: '/areas/', label: 'Areas', match: '/areas' },
  { href: '/industries/', label: 'Industries', match: '/industries' },
  { href: '/case-studies/', label: 'Case Studies', match: '/case-studies' },
  { href: '/about/', label: 'About', match: '/about' },
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SEO Reading" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="geo.region" content="GB-RDG" />
  <meta name="geo.placename" content="Reading, Berkshire" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  {schema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-brand focus:text-white focus:px-4 focus:py-2 focus:rounded focus:z-50">Skip to content</a>

  <!-- Top bar: subtle gold accent line -->
  <div class="h-[3px] bg-accent" aria-hidden="true"></div>

  <header class="sticky top-0 z-40 bg-white/98 backdrop-blur-sm border-b border-border/60" id="site-header">
    <nav class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
      <!-- Logo: serif wordmark -->
      <a href="/" class="group flex items-center gap-2">
        <span class="text-[0.7rem] font-semibold text-accent tracking-[0.15em] uppercase mt-[2px]">SEO</span>
        <span class="text-[1.35rem] font-bold text-brand tracking-tight transition-colors group-hover:text-brand-light" style="font-family: var(--font-serif)">Reading</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-7">
        {navLinks.map(({ href, label, match }) => (
          <a
            href={href}
            class={`text-[0.9rem] font-medium transition-colors relative pb-0.5 ${
              currentPath.startsWith(match)
                ? 'text-brand after:absolute after:bottom-0 after:left-0 after:w-full after:h-[2px] after:bg-accent'
                : 'text-text-muted hover:text-brand'
            }`}
          >{label}</a>
        ))}
        <a href="/contact/" class="btn btn-primary text-[0.85rem] py-2.5 px-5">Book a Consultation</a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-md hover:bg-surface transition-colors"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="burger-top" class="block w-5 h-[2px] bg-brand transition-all duration-300"></span>
        <span id="burger-mid" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-300"></span>
        <span id="burger-bot" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-300"></span>
      </button>
    </nav>

    <!-- Mobile menu: slide-down panel -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden bg-white border-t border-border/60 overflow-hidden transition-all duration-300"
      role="navigation"
      aria-label="Mobile navigation"
    >
      <div class="max-w-5xl mx-auto px-5 py-6 flex flex-col gap-1">
        {navLinks.map(({ href, label, match }) => (
          <a
            href={href}
            class={`block py-3 px-4 rounded-md text-[0.95rem] font-medium transition-colors ${
              currentPath.startsWith(match)
                ? 'bg-surface text-brand'
                : 'text-text-muted hover:bg-surface hover:text-brand'
            }`}
          >{label}</a>
        ))}
        <div class="mt-3 pt-3 border-t border-border">
          <a href="/contact/" class="btn btn-primary w-full text-center block">Book a Consultation</a>
        </div>
      </div>
    </div>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <footer class="bg-brand-dark text-white mt-20">
    <!-- Gold accent top -->
    <div class="h-[2px] bg-accent/40" aria-hidden="true"></div>

    <div class="max-w-5xl mx-auto px-5 pt-14 pb-10">
      <!-- Footer top: brand + columns -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
        <!-- Brand column -->
        <div class="md:col-span-4">
          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.65rem] font-semibold text-accent tracking-[0.15em] uppercase mt-[2px]">SEO</span>
            <span class="text-xl font-bold tracking-tight" style="font-family: var(--font-serif)">Reading</span>
          </div>
          <p class="text-sm text-gray-400 leading-relaxed max-w-xs">Search marketing consultancy based in Reading, Berkshire. We help Thames Valley businesses achieve prominence in Google and AI-powered search engines.</p>
          <div class="mt-5 flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Reading, Berkshire, UK
          </div>
        </div>

        <!-- Services column -->
        <div class="md:col-span-3">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Services</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li><a href="/services/" class="hover:text-white transition-colors">All Services</a></li>
            <li><a href="/technical-seo-reading/" class="hover:text-white transition-colors">Technical SEO</a></li>
            <li><a href="/seo-audit-reading/" class="hover:text-white transition-colors">SEO Audit</a></li>
            <li><a href="/ai-search-optimisation-reading/" class="hover:text-white transition-colors">AI Search Optimisation</a></li>
            <li><a href="/seo-pricing-reading/" class="hover:text-white transition-colors">Pricing</a></li>
          </ul>
        </div>

        <!-- Resources column -->
        <div class="md:col-span-2">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Explore</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li><a href="/free-seo-audit-reading/" class="hover:text-white transition-colors">Free Audit</a></li>
            <li><a href="/case-studies/" class="hover:text-white transition-colors">Case Studies</a></li>
            <li><a href="/areas/" class="hover:text-white transition-colors">Areas</a></li>
            <li><a href="/industries/" class="hover:text-white transition-colors">Industries</a></li>
          </ul>
        </div>

        <!-- Contact column -->
        <div class="md:col-span-3">
          <h4 class="text-xs font-semibold tracking-[0.12em] uppercase text-accent mb-4">Contact</h4>
          <ul class="space-y-2.5 text-sm text-gray-400">
            <li>
              <a href="mailto:hello@seoreading.uk" class="hover:text-white transition-colors flex items-center gap-2">
                <svg class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                hello@seoreading.uk
              </a>
            </li>
            <li><a href="/about/" class="hover:text-white transition-colors">About Us</a></li>
            <li><a href="/contact/" class="hover:text-white transition-colors">Get in Touch</a></li>
          </ul>
        </div>
      </div>

      <!-- Footer bottom -->
      <div class="border-t border-white/10 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
        <p>&copy; {year} SEO Reading. All rights reserved.</p>
        <div class="flex gap-5">
          <a href="/sitemap-index.xml" class="hover:text-gray-300 transition-colors">Sitemap</a>
          <a href="/llms.txt" class="hover:text-gray-300 transition-colors">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const burgerTop = document.getElementById('burger-top');
    const burgerMid = document.getElementById('burger-mid');
    const burgerBot = document.getElementById('burger-bot');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        menu.classList.toggle('hidden');

        // Animate burger to X
        if (!expanded) {
          burgerTop?.classList.add('translate-y-[7px]', 'rotate-45');
          burgerMid?.classList.add('opacity-0');
          burgerBot?.classList.add('-translate-y-[7px]', '-rotate-45');
        } else {
          burgerTop?.classList.remove('translate-y-[7px]', 'rotate-45');
          burgerMid?.classList.remove('opacity-0');
          burgerBot?.classList.remove('-translate-y-[7px]', '-rotate-45');
        }
      });
    }

    // Shrink header on scroll
    const header = document.getElementById('site-header');
    if (header) {
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        if (y > 60) {
          header.classList.add('py-0');
          header.querySelector('nav')?.classList.replace('py-4', 'py-2.5');
        } else {
          header.classList.remove('py-0');
          header.querySelector('nav')?.classList.replace('py-2.5', 'py-4');
        }
        lastScroll = y;
      }, { passive: true });
    }
  </script>
</body>
</html>
