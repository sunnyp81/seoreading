---
import '../styles/global.css';
import Riverline from '../components/Riverline.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object[];
}

const { title, description, canonical, schema = [] } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = 'https://seoreading.uk';
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const year = new Date().getFullYear();

const entitySchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://seoreading.uk/#organization",
  "name": "SEO Reading",
  "legalName": "ND MEDIA LTD",
  "identifier": "10784524",
  "url": "https://seoreading.uk/",
  "email": "hello@seoreading.uk",
  "areaServed": ["Reading", "Berkshire", "Thames Valley"],
  "sameAs": ["https://find-and-update.company-information.service.gov.uk/company/10784524"]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": "https://seoreading.uk/#website",
  "url": "https://seoreading.uk/",
  "name": "SEO Reading",
  "publisher": { "@id": "https://seoreading.uk/#organization" },
  "inLanguage": "en-GB"
};

const allSchema = [entitySchema, websiteSchema, ...schema];

const navLinks = [
  { href: '/services/', label: 'Services', match: '/services' },
  { href: '/seo-pricing-reading/', label: 'Pricing', match: '/seo-pricing-reading' },
  { href: '/areas/', label: 'Areas', match: '/areas' },
  { href: '/industries/', label: 'Industries', match: '/industries' },
  { href: '/case-studies/', label: 'Strategy Scenarios', match: '/case-studies' },
  { href: '/about/', label: 'About', match: '/about' },
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="SEO Reading" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />
  {allSchema.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
    <!-- GA4 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
      try {
        if (window.localStorage.getItem('seo-reading-analytics-consent') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        }
      } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-190NG3QSFD"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-190NG3QSFD');
    </script>
  </head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-brand focus:text-white focus:px-4 focus:py-2 focus:z-50">Skip to content</a>

  <header class="sticky top-0 z-40 bg-surface border-b border-rule" id="site-header">
    <nav class="max-w-6xl mx-auto px-5 py-3.5 flex items-center justify-between gap-4" aria-label="Primary">
      <!-- Wordmark: the gold keel under "Reading" is the same rule used throughout -->
      <a href="/" class="group flex items-baseline gap-1.5 shrink-0" aria-label="SEO Reading, home">
        <span class="text-[0.62rem] font-semibold text-accent-ink tracking-[0.2em] uppercase">SEO</span>
        <span class="relative text-[1.35rem] font-bold text-brand tracking-tight" style="font-family: var(--font-serif)">
          Reading
          <span class="absolute -bottom-0.5 left-0 h-[2px] w-full bg-accent" aria-hidden="true"></span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-6">
        {navLinks.map(({ href, label, match }) => (
          <a
            href={href}
            aria-current={currentPath.startsWith(match) ? 'page' : undefined}
            class:list={[
              'text-[0.875rem] py-1.5 border-b-2 transition-colors',
              currentPath.startsWith(match)
                ? 'text-brand font-semibold border-accent'
                : 'text-text-muted border-transparent hover:text-brand hover:border-rule'
            ]}
          >{label}</a>
        ))}
        <a href="/free-seo-audit-reading/" class="btn btn-primary text-[0.85rem] py-2 px-4">Free SEO audit</a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col justify-center items-center w-11 h-11 border border-border hover:border-brand transition-colors"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span id="burger-top" class="block w-5 h-[2px] bg-brand transition-all duration-200 origin-center"></span>
        <span id="burger-mid" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-200"></span>
        <span id="burger-bot" class="block w-5 h-[2px] bg-brand mt-[5px] transition-all duration-200 origin-center"></span>
      </button>
    </nav>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="lg:hidden overflow-hidden transition-all duration-300 max-h-0 invisible bg-surface border-t border-rule"
    >
      <nav class="max-w-6xl mx-auto px-5 py-4 flex flex-col" aria-label="Mobile">
        {navLinks.map(({ href, label, match }) => (
          <a
            href={href}
            aria-current={currentPath.startsWith(match) ? 'page' : undefined}
            class:list={[
              'flex items-center min-h-12 px-3 -mx-3 border-l-2 text-[0.95rem] transition-colors',
              currentPath.startsWith(match)
                ? 'border-accent text-brand font-semibold bg-surface-dark'
                : 'border-transparent text-text-muted hover:text-brand hover:bg-surface-dark'
            ]}
          >{label}</a>
        ))}
        <a href="/free-seo-audit-reading/" class="btn btn-primary w-full mt-4">Free SEO audit</a>
        <a href="/contact/" class="btn btn-outline w-full mt-2">Book a consultation</a>
      </nav>
    </div>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <footer class="bg-brand-dark text-white mt-20 relative">
    <div class="absolute inset-x-0 top-0 h-7 overflow-hidden" aria-hidden="true">
      <Riverline tone="light" class="h-7" />
    </div>

    <div class="max-w-6xl mx-auto px-5 pt-16 pb-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8">
        <!-- Identity -->
        <div class="md:col-span-4">
          <div class="flex items-baseline gap-1.5 mb-4">
            <span class="text-[0.6rem] font-semibold text-accent tracking-[0.2em] uppercase">SEO</span>
            <span class="relative text-xl font-bold tracking-tight" style="font-family: var(--font-serif)">
              Reading
              <span class="absolute -bottom-0.5 left-0 h-[2px] w-full bg-accent" aria-hidden="true"></span>
            </span>
          </div>
          <p class="text-sm text-[#A9B3C2] leading-relaxed max-w-xs">Remote-first search consultancy serving Reading, Berkshire, and the Thames Valley. SEO strategy and delivery are led by Sunny Patel.</p>
          <dl class="evidence evidence-dark mt-6 max-w-xs text-left">
            <div class="evidence-row">
              <dt class="evidence-key">service area</dt>
              <dd class="evidence-value">Reading, Berkshire, Thames Valley</dd>
            </div>
            <div class="evidence-row">
              <dt class="evidence-key">delivery</dt>
              <dd class="evidence-value">Remote-first, online consultations</dd>
            </div>
          </dl>
        </div>

        <!-- Services -->
        <div class="md:col-span-3">
          <h2 class="tag tag-on-dark mb-4">Services</h2>
          <ul class="space-y-2.5 text-sm text-[#A9B3C2]">
            <li><a href="/services/" class="hover:text-white transition-colors">All services</a></li>
            <li><a href="/technical-seo-reading/" class="hover:text-white transition-colors">Technical SEO</a></li>
            <li><a href="/seo-audit-reading/" class="hover:text-white transition-colors">SEO audit</a></li>
            <li><a href="/ai-search-optimisation-reading/" class="hover:text-white transition-colors">AI search optimisation</a></li>
            <li><a href="/seo-pricing-reading/" class="hover:text-white transition-colors">Pricing</a></li>
          </ul>
        </div>

        <!-- Explore -->
        <div class="md:col-span-2">
          <h2 class="tag tag-on-dark mb-4">Explore</h2>
          <ul class="space-y-2.5 text-sm text-[#A9B3C2]">
            <li><a href="/free-seo-audit-reading/" class="hover:text-white transition-colors">Free audit</a></li>
            <li><a href="/case-studies/" class="hover:text-white transition-colors">Strategy scenarios</a></li>
            <li><a href="/areas/" class="hover:text-white transition-colors">Areas</a></li>
            <li><a href="/industries/" class="hover:text-white transition-colors">Industries</a></li>
            <li><a href="/tools/local-seo-checklist/" class="hover:text-white transition-colors">Local SEO checklist</a></li>
            <li><a href="/tools/schema-generator/" class="hover:text-white transition-colors">Schema generator</a></li>
            <li><a href="/tools/seo-roi-calculator/" class="hover:text-white transition-colors">SEO ROI calculator</a></li>
          </ul>
        </div>

        <!-- Contact -->
        <div class="md:col-span-3">
          <h2 class="tag tag-on-dark mb-4">Contact</h2>
          <ul class="space-y-2.5 text-sm text-[#A9B3C2]">
            <li><a href="mailto:hello@seoreading.uk" class="hover:text-white transition-colors">hello@seoreading.uk</a></li>
            <li><a href="/about/" class="hover:text-white transition-colors">About SEO Reading</a></li>
            <li><a href="/contact/" class="hover:text-white transition-colors">Book a consultation</a></li>
          </ul>
        </div>
      </div>

      <div class="border-t border-white/12 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs text-[#8E99A8]">
        <p>&copy; {year} SEO Reading. Operated by <a href="https://find-and-update.company-information.service.gov.uk/company/10784524" rel="noopener noreferrer" class="underline decoration-white/25 underline-offset-4 hover:text-white transition-colors">ND Media Ltd</a>, company no. 10784524.</p>
        <div class="flex flex-wrap gap-5">
          <a href="/privacy/" class="hover:text-white transition-colors">Privacy</a>
          <a href="/sitemap-index.xml" class="hover:text-white transition-colors">Sitemap</a>
          <a href="/llms.txt" class="hover:text-white transition-colors">llms.txt</a>
        </div>
      </div>
    </div>
  </footer>

  <div id="analytics-consent" class="consent-banner" hidden role="region" aria-label="Analytics cookies">
    <p><strong>Analytics choice</strong><br />Google Analytics helps us understand site use. It stays off unless you accept.</p>
    <div class="consent-actions">
      <button type="button" id="analytics-decline" class="btn btn-outline">Decline</button>
      <button type="button" id="analytics-accept" class="btn btn-primary">Accept analytics</button>
    </div>
  </div>

  <script>
    // Mobile menu
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const burgerTop = document.getElementById('burger-top');
    const burgerMid = document.getElementById('burger-mid');
    const burgerBot = document.getElementById('burger-bot');

    if (btn && menu) {
      const closeMobileMenu = () => {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open navigation');
        menu.style.maxHeight = '0';
        // visibility, not just height: collapsed links must leave the tab order
        menu.classList.add('invisible');
        burgerTop?.classList.remove('translate-y-[7px]', 'rotate-45');
        burgerMid?.classList.remove('opacity-0');
        burgerBot?.classList.remove('-translate-y-[7px]', '-rotate-45');
      };

      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));

        if (!expanded) {
          btn.setAttribute('aria-label', 'Close navigation');
          menu.classList.remove('invisible');
          menu.style.maxHeight = menu.scrollHeight + 'px';
          burgerTop?.classList.add('translate-y-[7px]', 'rotate-45');
          burgerMid?.classList.add('opacity-0');
          burgerBot?.classList.add('-translate-y-[7px]', '-rotate-45');
        } else {
          closeMobileMenu();
        }
      });
      menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMobileMenu));
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
          closeMobileMenu();
          btn.focus();
        }
      });
    }

    // Horizontal tables remain reachable by keyboard at narrow widths.
    document.querySelectorAll('.prose table').forEach((table, index) => {
      table.setAttribute('tabindex', '0');
      if (!table.hasAttribute('aria-label')) table.setAttribute('aria-label', `Data table ${index + 1}; scroll horizontally on small screens`);
    });

    // Optional analytics consent. Necessary form and site functions do not depend on it.
    const consentBanner = document.getElementById('analytics-consent');
    const acceptAnalytics = document.getElementById('analytics-accept');
    const declineAnalytics = document.getElementById('analytics-decline');
    try {
      if (consentBanner && !window.localStorage.getItem('seo-reading-analytics-consent')) consentBanner.hidden = false;
    } catch (e) {
      if (consentBanner) consentBanner.hidden = false;
    }
    const saveAnalyticsChoice = (choice: 'granted' | 'denied') => {
      try { window.localStorage.setItem('seo-reading-analytics-consent', choice); } catch (e) {}
      gtag('consent', 'update', { analytics_storage: choice });
      if (consentBanner) consentBanner.hidden = true;
    };
    acceptAnalytics?.addEventListener('click', () => saveAnalyticsChoice('granted'));
    declineAnalytics?.addEventListener('click', () => saveAnalyticsChoice('denied'));
  </script>

<!-- Post-submit confirmation. On a static build Astro.url.searchParams is empty at
     runtime, so the ?sent=1 check has to happen client side or the visitor sees the
     same empty form and assumes the send failed. -->
<script is:inline>
  (function () {
    var track = function (eventName, parameters) {
      if (typeof window.gtag === 'function') window.gtag('event', eventName, parameters);
    };

    document.addEventListener('click', function (event) {
      var target = event.target;
      var link = target && target.closest ? target.closest('a[href^="tel:"], a[href^="mailto:"]') : null;
      if (!link) return;
      var href = link.getAttribute('href') || '';
      track(href.indexOf('tel:') === 0 ? 'click_to_call' : 'click_to_email', {
        contact_method: href.indexOf('tel:') === 0 ? 'phone' : 'email',
        page_path: window.location.pathname,
        transport_type: 'beacon'
      });
    });

    var params;
    try { params = new URLSearchParams(window.location.search); }
    catch (e) { return; }
    if (params.get('sent') !== '1') return;
    var run = function () {
      var existingConfirmation = document.querySelector('[data-form-confirmation]');
      if (existingConfirmation) existingConfirmation.hidden = false;
      var insertedConfirmation = false;
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        var f = forms[i];
        if (!f.querySelector('[name="redirectTo"], [name="redirect"]')) continue;
        if (!existingConfirmation && !insertedConfirmation) {
          var box = document.createElement('div');
          box.setAttribute('role', 'status');
          box.style.cssText = 'border:1px solid currentColor;border-radius:8px;padding:1.25rem 1.5rem;margin:0 0 1.5rem;line-height:1.5';
          box.innerHTML = '<strong>Thanks, your message has been sent.</strong><br>We have received it and will be in touch.';
          f.parentNode.insertBefore(box, f);
          insertedConfirmation = true;
        }
        f.hidden = true;
      }
      track('generate_lead', {
        form_name: params.get('form') || 'enquiry',
        page_path: window.location.pathname,
        transport_type: 'beacon'
      });
      window.history.replaceState({}, document.title, window.location.pathname + window.location.hash);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
    else run();
  })();
</script>
</body>
</html>
