        <div class="lg:col-span-6">
          <SectionHeading
            id="decide-heading"
            tone="light"
            title="Decide with the numbers in front of you"
            lede="Published pricing, so you can size the commitment before you speak to anyone. Final scope and fees are agreed before paid work begins."
          />
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="/free-seo-audit-reading/" class="btn btn-primary">Get your free audit</a>
            <a href="/seo-pricing-reading/" class="btn btn-ghost-light">See full pricing</a>
          </div>
          <p class="mt-5 text-sm text-[#A9B3C2]">
            Prefer to talk it through first? <a href="/contact/" class="text-white underline decoration-accent underline-offset-4">Book a consultation</a>. We aim to reply within one working day.
          </p>
        </div>

        <div class="lg:col-span-6">
          <dl class="evidence evidence-dark">
            <div class="evidence-row">
              <dt class="evidence-key">free health check</dt>
              <dd class="evidence-value">No cost, five checks, one priority action</dd>
            </div>
            <div class="evidence-row">
              <dt class="evidence-key">paid SEO audit</dt>
              <dd class="evidence-value">From £300, one-off</dd>
            </div>
            <div class="evidence-row">
              <dt class="evidence-key">monthly retainer</dt>
              <dd class="evidence-value">£500 to £2,000 per month by tier</dd>
            </div>
            <div class="evidence-row">
              <dt class="evidence-key">commitment</dt>
              <dd class="evidence-value">Initial three months, then rolling with 30 days&rsquo; notice</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

</Base>
