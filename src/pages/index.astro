  <!-- ═══ DECISION POINT: scope and price, then the one action ═══ -->
  <section class="bg-brand text-white relative" aria-labelledby="decide-heading">
    <div class="absolute inset-x-0 top-0 h-9 overflow-hidden" aria-hidden="true">
      <Riverline tone="light" class="h-9" />
    </div>
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-5 pt-20 pb-16 md:pt-24 md:pb-20 relative z-10">
