---
import Base from '../layouts/Base.astro';
import Riverline from '../components/Riverline.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EvidenceList from '../components/EvidenceList.astro';

const title = 'SEO Reading | SEO Consultancy in Reading';
const description = 'Reading SEO consultancy for local, technical, and AI search strategy. Clear audits and practical optimisation for businesses across Berkshire.';

const faqItems = [
  {
    q: 'What does SEO typically cost for a Reading business?',
    a: 'SEO pricing in Reading varies according to scope and competitive intensity. A one-off audit starts at £300, whilst ongoing monthly retainers range from £500 to £2,000 depending on the number of target keywords, competitive landscape, and whether the campaign is confined to local search or extends nationally. We publish these prices in full on our pricing page and agree the final scope and fee with you before paid work begins.'
  },
  {
    q: 'How long before SEO produces measurable results?',
    a: 'SEO timelines depend on your current site, competition, content, authority, and the work required. Technical changes may be reflected after recrawling, while competitive commercial terms usually need sustained work over several months. We establish a baseline before implementation and report observed progress rather than promising a fixed ranking date.'
  },
  {
    q: 'Does SEO Reading only serve businesses based in Reading?',
    a: 'SEO Reading is a remote-first consultancy serving Reading, Berkshire, and the wider Thames Valley. Consultations and reporting happen online. In-person meetings in the Reading area can be arranged by prior agreement; there is no walk-in office.'
  },
  {
    q: 'What is local SEO and why does it matter for businesses in Reading?',
    a: 'Local SEO improves a website and business profile for location-specific searches. Google may show local results such as the map pack, but visibility depends on relevance, distance, prominence, and eligibility. A local SEO plan improves the signals a business can control; it cannot guarantee a map-pack placement.'
  },
  {
    q: 'What is AI search optimisation and is it relevant to my business?',
    a: 'AI search optimisation, also referred to as AEO or GEO, ensures that a business receives citations when prospective clients use AI tools such as ChatGPT, Perplexity, Google AI Overviews, and Microsoft Copilot to find services. These platforms are progressively replacing traditional search for a wide range of queries. If competitors are being recommended by AI systems and one\'s own business is not, that represents a tangible loss of leads. We incorporate this discipline into every SEO campaign as standard.'
  },
  {
    q: 'Can you assist with Google Business Profile optimisation?',
    a: 'Indeed. Google Business Profile (formerly Google My Business) forms a core component of our local SEO service. We optimise the profile in its entirety, manage review strategy, post regular updates, assign relevant categories and attributes, and ensure NAP consistency across all directories. A well-optimised GBP is, in many cases, the single most significant driver of local enquiries.'
  },
  {
    q: 'Do you provide one-off SEO audits?',
    a: 'We offer a complimentary initial SEO audit covering the fundamentals: indexation, page speed, schema markup, local signals, and competitor positioning. For businesses requiring a more thorough technical audit accompanied by a comprehensive action plan, we provide a paid in-depth audit. Both options are accessible through our audit request page.'
  },
  {
    q: 'How does SEO Reading differ from a London agency?',
    a: 'SEO Reading is a remote-first consultancy for Reading and Berkshire businesses. You work directly with Sunny Patel, whose public profile documents more than 15 years in SEO. Scope and fees are discussed before work begins, and meetings take place online by default.'
  }
];

// Mirrors the five checks published on /free-seo-audit-reading/. Scope, not results.
const freeCheckRows = [
  { key: 'indexation', value: 'Which pages Google holds, and which are missing or should not be there' },
  { key: 'core web vitals', value: 'LCP, INP, and CLS measured against Google’s thresholds' },
  { key: 'local signals', value: 'Google Business Profile setup and NAP consistency across Reading directories' },
  { key: 'query snapshot', value: 'The queries your site already appears for, and at what positions' },
  { key: 'priority action', value: 'The single highest-impact change to make first' }
];

const credentials = [
  {
    key: 'practitioner',
    value: 'Sunny Patel, <a href="https://sunnypatel.co.uk/" class="underline decoration-accent underline-offset-4">public profile documents 15+ years in SEO</a>'
  },
  { key: 'delivery', value: 'Senior-led strategy and delivery, no account-manager layer' },
  {
    key: 'company',
    value: 'ND Media Ltd, <a href="https://find-and-update.company-information.service.gov.uk/company/10784524" rel="noopener noreferrer" class="underline decoration-accent underline-offset-4">company no. 10784524 at Companies House</a>'
  },
  {
    key: 'scope and fees',
    value: '<a href="/seo-pricing-reading/" class="underline decoration-accent underline-offset-4">Published audit and retainer pricing</a>, agreed before paid work starts'
  }
];

const services = [
  {
    href: '/areas/',
    name: 'Local SEO',
    desc: 'Google Business Profile optimisation, local citation building, review strategy, and on-page optimisation for location-specific keywords across Reading and the Thames Valley.',
    cta: 'Explore Reading area strategy'
  },
  {
    href: '/technical-seo-reading/',
    name: 'Technical SEO',
    desc: 'Site speed, crawlability, schema markup, mobile experience. We audit and fix the infrastructure issues silently undermining your rankings.',
    cta: 'Technical SEO in Reading'
  },
  {
    href: '/seo-audit-reading/',
    name: 'SEO audits',
    desc: 'Thorough technical health, content gap, backlink, and competitor analysis. Every recommendation is specific and actionable.',
    cta: 'What an audit covers'
  },
  {
    href: '/ai-search-optimisation-reading/',
    name: 'AI search optimisation',
    desc: 'Get cited by ChatGPT, Perplexity, Google AI Overviews, and Microsoft Copilot. Entity optimisation, structured data, and authoritative content.',
    cta: 'AI search optimisation'
  },
  {
    href: '/services/',
    name: 'Content strategy',
    desc: 'Keyword-researched service pages, location pages, FAQ content, and editorial pieces that collectively establish your site as the most relevant result. Grounded in verified search demand.',
    cta: 'All services'
  }
];

const areas = [
  { name: 'Reading centre', desc: 'Broad Street, Forbury Square, the station quarter' },
  { name: 'Caversham', desc: 'Including Caversham Heights and Emmer Green' },
  { name: 'Tilehurst', desc: 'West Reading residential area' },
  { name: 'Earley', desc: 'Near University of Reading campus' },
  { name: 'Woodley', desc: 'East Reading independent high street' },
  { name: 'Wokingham', desc: 'Affluent market town' },
  { name: 'Bracknell', desc: 'Tech and finance hub' },
  { name: 'Newbury', desc: 'West Berkshire, Vodafone HQ' },
  { name: 'Henley-on-Thames', desc: 'Premium services market' },
  { name: 'Maidenhead', desc: 'Eastern Berkshire corridor' }
];

const industries = [
  { title: 'Technology and SaaS', desc: 'Green Park, Thames Valley Park, M4 corridor. Product-led content and bottom-of-funnel conversion.' },
  { title: 'Legal services', desc: 'Forbury Square cluster. YMYL content, SRA compliance, practice-area targeting.' },
  { title: 'Estate agents', desc: 'Local pack visibility, area guides, buyer-intent keywords.' },
  { title: 'Financial services', desc: 'Accountants, IFAs, mortgage brokers. YMYL standards, trust signalling, FCA directories.' },
  { title: 'Hospitality', desc: 'The Oracle, Broad Street, King’s Road. GBP optimisation, review strategy, menu schema.' },
  { title: 'Trades and home services', desc: 'Plumbers, electricians, builders. Hyperlocal "near me" queries across Reading suburbs.' }
];

const process = [
  { step: 'Audit', desc: 'Comprehensive analysis of technical health, content, backlinks, local signals, and competitors. Prioritised action plan with expected outcomes.' },
  { step: 'Strategy', desc: '90-day SEO strategy tailored to your industry and geographic targets. Written in plain English with clear rationale.' },
  { step: 'Implement', desc: 'We execute directly: technical fixes, content production, citation building, schema deployment, GBP optimisation.' },
  { step: 'Report and iterate', desc: 'Monthly reporting on rankings, traffic, GBP performance, and conversions. Strategy refined each month based on data.' }
];

const expectations = [
  { title: 'Reading and Berkshire focus', desc: 'Local search plans reflect the areas, competitors, and customer journeys that matter to your business. Delivery is remote-first, with online consultations and reporting.' },
  { title: 'Senior-led delivery', desc: 'Sunny Patel leads the strategy and delivery directly. His public profile documents more than 15 years in SEO and links to examples of first-party portfolio work.' },
  { title: 'Clear, published pricing', desc: 'Review the audit and monthly service ranges before you enquire. The proposed scope and fees are agreed before any paid work starts.' },
  { title: 'Work shown with context', desc: 'Public portfolio examples on the Sunny Patel profile are owned properties with first-party Search Console data. They are not presented as client results.' }
];

// Shares the layout's organisation @id so this resolves to one entity with the
// local-business detail attached, not a second competing Organization node.
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://seoreading.uk/#organization",
  "name": "SEO Reading",
  "url": "https://seoreading.uk",
  "description": "Specialist SEO consultancy serving Reading, Berkshire and the Thames Valley",
  "areaServed": [
    { "@type": "City", "name": "Reading" },
    { "@type": "City", "name": "Caversham" },
    { "@type": "City", "name": "Tilehurst" },
    { "@type": "City", "name": "Earley" },
    { "@type": "City", "name": "Woodley" },
    { "@type": "City", "name": "Wokingham" },
    { "@type": "City", "name": "Bracknell" },
    { "@type": "AdministrativeArea", "name": "Berkshire" },
    { "@type": "AdministrativeArea", "name": "Thames Valley" }
  ],
  "email": "hello@seoreading.uk"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "https://seoreading.uk/#breadcrumb",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const schema = [orgSchema, breadcrumbSchema, faqSchema];
---

<Base title={title} description={description} schema={schema}>

  <!-- ═══ HERO: the offer, then the method, then the two ways in ═══ -->
  <section class="relative overflow-hidden bg-brand text-white" aria-labelledby="hero-heading">
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-6xl mx-auto px-5 pt-16 pb-24 md:pt-24 md:pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

        <div class="min-w-0 lg:col-span-7">
          <p class="tag tag-on-dark mb-4 fade-up">Reading · Berkshire · Thames Valley · remote-first</p>
          <h1 id="hero-heading" class="font-bold leading-[1.06] tracking-tight mb-6 fade-up max-w-[16ch]" style="font-family: var(--font-serif); font-size: clamp(2.2rem, 5.6vw, 3.6rem); transition-delay: 60ms;">
            Grow your Reading business through search that converts
          </h1>
          <p class="text-[#C7CEDA] text-lg leading-relaxed max-w-[52ch] mb-8 fade-up" style="transition-delay: 120ms;">
            We help Thames Valley businesses compete for local search visibility in Google and earn citations from ChatGPT, Perplexity, and AI Overviews. Senior-led strategy, published pricing, scope agreed before work starts.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 fade-up" style="transition-delay: 180ms;">
            <a href="/free-seo-audit-reading/" class="btn btn-primary text-base px-7">Get your free audit</a>
            <a href="/seo-pricing-reading/" class="btn btn-ghost-light px-7">See SEO pricing</a>
          </div>
        </div>

        <!-- Second eye: what a check actually inspects. Scope, not results. -->
        <div class="min-w-0 lg:col-span-5 fade-up" style="transition-delay: 240ms;">
          <div class="border-l-2 border-accent pl-5 md:pl-6">
            <h2 class="tag tag-on-dark mb-4">The free check inspects</h2>
            <EvidenceList items={freeCheckRows} dark={true} />
            <p class="mt-4 text-sm text-[#A9B3C2]">
              Sent as a short PDF. <a href="/free-seo-audit-reading/" class="text-white underline decoration-accent underline-offset-4">Read the full scope</a>.
            </p>
          </div>
        </div>

      </div>
    </div>

    <div class="absolute inset-x-0 bottom-0 h-10 overflow-hidden" aria-hidden="true">
      <Riverline tone="light" class="h-10" />
    </div>
  </section>

  <!-- ═══ WHO IS BEHIND IT ═══ -->
  <section class="bg-paper border-b border-rule py-10 md:py-12" aria-labelledby="credentials-heading">
    <div class="max-w-6xl mx-auto px-5">
      <h2 id="credentials-heading" class="tag mb-5">Who you are dealing with</h2>
      <EvidenceList items={credentials} />
    </div>
  </section>

  <!-- ═══ WHY READING ═══ -->
  <section class="py-16 md:py-24 relative" aria-labelledby="intro-heading">
    <div class="absolute inset-0 dot-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <SectionHeading
        id="intro-heading"
        title="Why Reading businesses need local SEO"
        lede="Reading is one of the most commercially vibrant towns in the South East. Forbury Square houses major professional services firms. Green Park and Thames Valley Park accommodate corporate headquarters. This density means competition for local search visibility is exceptionally fierce."
      />

      <div class="grid md:grid-cols-3 gap-x-10 gap-y-8 mt-12">
        {[
          { title: 'Local pack visibility', desc: 'Google often shows a local pack for location-led searches. Accurate business information, relevance, prominence, and distance all affect whether a business is eligible to appear.' },
          { title: 'Multi-area reach', desc: 'Reading’s catchment spans Caversham, Tilehurst, Earley, Woodley, Wokingham, and Bracknell. A properly structured campaign captures demand across all areas from a single website.' },
          { title: 'AI search readiness', desc: 'ChatGPT, Perplexity, and Google AI Overviews now answer commercial queries directly. If AI systems do not cite your business, you forfeit visibility even where traditional rankings remain strong.' }
        ].map((item, i) => (
          <div class="border-t-2 border-brand pt-5 fade-up stagger-child" style={`--i: ${i}`}>
            <p class="tag mb-2">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="font-semibold text-brand text-lg mb-2" style="font-family: var(--font-serif);">{item.title}</h3>
            <p class="text-text-muted text-[0.95rem] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES: an index you can read down, not a wall of tiles ═══ -->
  <section class="py-16 md:py-24 bg-paper" aria-labelledby="services-heading">
    <div class="max-w-6xl mx-auto px-5">
      <SectionHeading
        id="services-heading"
        title="Our SEO services for Reading businesses"
        lede="Every service is built around measurable outcomes: improved rankings, increased traffic, and a greater volume of qualified leads."
      />

      <ul class="mt-12 border-t border-rule">
        {services.map((service, i) => (
          <li class="border-b border-rule">
            <a href={service.href} class="group grid md:grid-cols-12 gap-x-8 gap-y-2 py-6 md:py-7 no-underline items-baseline transition-colors hover:bg-surface">
              <span class="tag md:col-span-1">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="md:col-span-4 font-semibold text-brand text-xl group-hover:text-accent-ink transition-colors" style="font-family: var(--font-serif);">{service.name}</h3>
              <p class="md:col-span-6 text-text-muted text-[0.95rem] leading-relaxed">{service.desc}</p>
              <span class="md:col-span-1 text-accent-ink text-sm font-semibold whitespace-nowrap md:text-right" aria-hidden="true">&rarr;</span>
              <span class="sr-only">{service.cta}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ AREAS ═══ -->
  <section class="py-16 md:py-24 relative" aria-labelledby="areas-heading">
    <div class="absolute inset-0 dot-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <SectionHeading
        id="areas-heading"
        title="Areas we cover across Berkshire"
        tag="Thames Valley, from Newbury to Maidenhead"
        lede="Each town is a separate local market in Google. We plan targeting, content, and citations town by town."
      />

      <div class="mt-10 mb-2 h-8 overflow-hidden" aria-hidden="true">
        <Riverline tone="navy" class="opacity-60" />
      </div>

      <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 border-b border-rule">
        {areas.map(area => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-rule py-3.5">
            <span class="font-semibold text-brand text-[0.98rem]" style="font-family: var(--font-serif);">{area.name}</span>
            <span class="text-text-muted text-[0.82rem] leading-snug">{area.desc}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 fade-up">
        <a href="/areas/" class="btn btn-outline text-sm">See all areas we cover</a>
      </div>
    </div>
  </section>

  <!-- ═══ INDUSTRIES ═══ -->
  <section class="py-16 md:py-24 bg-brand text-white relative" aria-labelledby="industries-heading">
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <SectionHeading
        id="industries-heading"
        tone="light"
        title="Industries we specialise in"
        lede="Reading's economy is notably diverse. Different industries demand tailored SEO approaches."
      />

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-8 mt-12">
        {industries.map((industry, i) => (
          <div class="border-t border-white/25 pt-5 fade-up stagger-child" style={`--i: ${i}`}>
            <p class="tag tag-on-dark mb-2">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="font-semibold text-white text-lg mb-2" style="font-family: var(--font-serif);">{industry.title}</h3>
            <p class="text-[#A9B3C2] text-sm leading-relaxed">{industry.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 fade-up">
        <a href="/industries/" class="btn btn-ghost-light text-sm">Explore all industries</a>
      </div>
    </div>
  </section>

  <!-- ═══ PROCESS: the four steps threaded along the river rule ═══ -->
  <section class="py-16 md:py-24 bg-paper" aria-labelledby="process-heading">
    <div class="max-w-6xl mx-auto px-5">
      <SectionHeading
        id="process-heading"
        title="How we work"
        lede="Methodical, transparent, no twelve-month lock-in."
      />

      <div class="relative mt-12">
        <div class="hidden md:block absolute inset-x-0 top-5 h-10 overflow-hidden" aria-hidden="true">
          <Riverline tone="navy" class="h-10 opacity-70" />
        </div>

        <ol class="relative grid md:grid-cols-4 gap-x-8 gap-y-8">
          {process.map((item, i) => (
            <li class="fade-up stagger-child" style={`--i: ${i}`}>
              <span class="inline-flex items-center justify-center w-10 h-10 bg-brand text-[#D4AF37] font-semibold text-[0.8rem] tabular-nums" style="font-family: var(--font-mono);">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-semibold text-brand text-lg mt-4 mb-2" style="font-family: var(--font-serif);">{item.step}</h3>
              <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT TO EXPECT ═══ -->
  <section class="py-16 md:py-24 relative" aria-labelledby="whyus-heading">
    <div class="absolute inset-0 dot-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <SectionHeading id="whyus-heading" title="What to expect from SEO Reading" />

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-8 mt-12">
        {expectations.map((item, i) => (
          <div class="border-t-2 border-brand pt-5 fade-up stagger-child" style={`--i: ${i}`}>
            <h3 class="font-semibold text-brand text-lg mb-2" style="font-family: var(--font-serif);">{item.title}</h3>
            <p class="text-text-muted text-[0.95rem] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ AI SEARCH: evidence, with its provenance stated in the same view ═══ -->
  <section class="py-16 md:py-24 bg-brand text-white relative" aria-labelledby="ai-heading">
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-5 relative z-10">
      <SectionHeading
        id="ai-heading"
        tone="light"
        title="AI search optimisation"
        lede="AI referral traffic can be measured in analytics, so it can be worked on deliberately rather than hoped for."
      />

      <figure class="mt-10 border-l-2 border-accent pl-5 md:pl-6 fade-up">
        <dl class="evidence evidence-dark">
          <div class="evidence-row">
            <dt class="evidence-key">measured</dt>
            <dd class="evidence-value">4,717 sessions from AI assistants</dd>
          </div>
          <div class="evidence-row">
            <dt class="evidence-key">source</dt>
            <dd class="evidence-value">GA4, across 12 owned portfolio sites</dd>
          </div>
          <div class="evidence-row">
            <dt class="evidence-key">window</dt>
            <dd class="evidence-value">28 May to 26 August 2026</dd>
          </div>
          <div class="evidence-row">
            <dt class="evidence-key">not</dt>
            <dd class="evidence-value">Reading-site performance, and not a client result</dd>
          </div>
        </dl>
        <figcaption class="mt-4 text-sm text-[#A9B3C2]">
          The study shows portfolio-wide results on properties Sunny Patel owns. <a href="https://sunnypatel.co.uk/blog/ai-referral-traffic-study/" class="text-white underline decoration-accent underline-offset-4">Read the method and sector breakdown</a>.
        </figcaption>
      </figure>

      <div class="mt-9 fade-up">
        <a href="/ai-search-optimisation-reading/" class="btn btn-primary">Learn about AI search</a>
      </div>
    </div>
  </section>

  <!-- ═══ STRATEGY SCENARIOS ═══ -->
  <section class="py-16 md:py-24 bg-paper" aria-labelledby="cases-heading">
    <div class="max-w-6xl mx-auto px-5">
      <SectionHeading
        id="cases-heading"
        title="Illustrative SEO plans"
        tag="Strategy scenarios, not client case studies"
        lede="The Reading examples below show how a campaign would be sequenced. They are illustrative, and they contain no client outcomes."
      />

      <div class="grid md:grid-cols-2 gap-x-10 gap-y-8 mt-10">
        <a href="/case-studies/reading-law-firm-organic-growth/" class="group block border-t-2 border-brand pt-5 no-underline hover:border-accent transition-colors fade-up">
          <p class="tag mb-2">Legal sector · illustrative</p>
          <h3 class="font-bold text-brand text-xl mb-2 group-hover:text-accent-ink transition-colors" style="font-family: var(--font-serif);">Reading law firm SEO growth plan</h3>
          <p class="text-text-muted text-sm leading-relaxed">An illustrative plan showing how technical SEO, practice-area content, and local optimisation can be sequenced for a Reading law firm.</p>
          <span class="mt-3 inline-block text-accent-ink text-sm font-semibold">Read the scenario &rarr;</span>
        </a>
        <a href="/case-studies/caversham-estate-agent-google-maps-dominance/" class="group block border-t-2 border-brand pt-5 no-underline hover:border-accent transition-colors fade-up stagger-child" style="--i: 1">
          <p class="tag mb-2">Property sector · illustrative</p>
          <h3 class="font-bold text-brand text-xl mb-2 group-hover:text-accent-ink transition-colors" style="font-family: var(--font-serif);">Caversham estate agent: Google Maps visibility</h3>
          <p class="text-text-muted text-sm leading-relaxed">An illustrative campaign: an independent estate agent builds Google Maps visibility across Reading, capturing the local pack for property searches in Caversham, Tilehurst, and Earley.</p>
          <span class="mt-3 inline-block text-accent-ink text-sm font-semibold">Read the scenario &rarr;</span>
        </a>
      </div>

      <p class="mt-8 text-sm text-text-muted max-w-3xl">
        For wider-portfolio evidence, see the <a href="https://sunnypatel.co.uk/portfolio/aatma-aesthetics-website-design-development-seo/" class="text-brand underline decoration-accent underline-offset-4">2025 Aatma Aesthetics healthcare case study</a>; it is not a Reading client result. Sunny Patel&rsquo;s <a href="https://sunnypatel.co.uk/portfolio/" class="text-brand underline decoration-accent underline-offset-4">owned-site portfolio</a> shows first-party Search Console results separately.
      </p>
    </div>
