---
import Base from '../layouts/Base.astro';

const title = 'SEO Reading | SEO Consultancy in Reading';
const description = 'SEO Reading is a specialist search consultancy serving businesses across Reading and Berkshire. We deliver measurable results through local SEO, technical optimisation, and AI search strategy.';

const faqItems = [
  {
    q: 'What does SEO typically cost for a Reading business?',
    a: 'SEO pricing in Reading varies according to scope and competitive intensity. A one-off audit begins from approximately £500, whilst ongoing monthly retainers typically range from £750 to £2,500 depending on the number of target keywords, competitive landscape, and whether the campaign is confined to local search or extends nationally. We publish transparent pricing on our pricing page and tailor every quotation to the individual business.'
  },
  {
    q: 'How long before SEO produces measurable results?',
    a: 'In our experience, most Reading businesses observe measurable ranking improvements within 8 to 12 weeks. Local SEO campaigns targeting Google Maps and the local pack can yield results more rapidly, sometimes within 4 to 6 weeks. Competitive national keywords require greater patience, typically 4 to 6 months for significant movement. We establish realistic timelines during the strategy phase and report progress on a monthly basis.'
  },
  {
    q: 'Does SEO Reading only serve businesses based in Reading?',
    a: 'We serve the entire Thames Valley including Wokingham, Bracknell, Newbury, Henley-on-Thames, Maidenhead, and Slough. Moreover, we work with UK-wide businesses that require local SEO for their Reading or Berkshire presence. Our office is situated in Reading, which affords the opportunity for face-to-face meetings when the situation warrants it.'
  },
  {
    q: 'What is local SEO and why does it matter for businesses in Reading?',
    a: 'Local SEO is the practice of optimising a website and broader online presence to rank in location-specific searches. When someone in Reading searches for "accountant near me" or "solicitor Reading", Google surfaces local results including the map pack. Local SEO ensures that a business appears in those results. For Reading businesses competing against London agencies and national chains, a well-executed local SEO strategy is frequently the most cost-effective marketing channel available.'
  },
  {
    q: 'What is AI search optimisation and is it relevant to my business?',
    a: 'AI search optimisation, also referred to as AEO or GEO, ensures that a business receives citations when prospective clients use AI tools such as ChatGPT, Perplexity, Google AI Overviews, and Microsoft Copilot to find services. These platforms are progressively replacing traditional search for a wide range of queries. If competitors are being recommended by AI systems and one\'s own business is not, that represents a tangible loss of leads. We incorporate this discipline into every SEO campaign as standard.'
  },
  {
    q: 'Can you assist with Google Business Profile optimisation?',
    a: 'Indeed. Google Business Profile (formerly Google My Business) forms a core component of our local SEO service. We optimise the profile in its entirety, manage review strategy, post regular updates, assign relevant categories and attributes, and ensure NAP consistency across all directories. A well-optimised GBP is, in many cases, the single most significant driver of local enquiries.'
  },
  {
    q: 'Do you provide one-off SEO audits?',
    a: 'We offer a complimentary initial SEO audit covering the fundamentals: indexation, page speed, schema markup, local signals, and competitor positioning. For businesses requiring a more thorough technical audit accompanied by a comprehensive action plan, we provide a paid in-depth audit. Both options are accessible through our audit request page.'
  },
  {
    q: 'How does SEO Reading differ from a London agency?',
    a: 'We are established in Reading and possess an intimate understanding of local search behaviour, competitive dynamics, and the Berkshire business landscape. London agencies typically apply London rates and frequently delegate Reading accounts to junior staff. SEO Reading provides senior-level strategy and execution at Thames Valley pricing, with the additional benefit of in-person meetings at your premises or ours.'
  }
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "LocalBusiness"],
  "name": "SEO Reading",
  "url": "https://seoreading.uk",
  "description": "Specialist SEO consultancy serving Reading, Berkshire and the Thames Valley",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Reading",
    "addressRegion": "Berkshire",
    "addressCountry": "GB"
  },
  "areaServed": [
    { "@type": "City", "name": "Reading" },
    { "@type": "City", "name": "Caversham" },
    { "@type": "City", "name": "Tilehurst" },
    { "@type": "City", "name": "Earley" },
    { "@type": "City", "name": "Woodley" },
    { "@type": "City", "name": "Wokingham" },
    { "@type": "City", "name": "Bracknell" },
    { "@type": "AdministrativeArea", "name": "Berkshire" },
    { "@type": "AdministrativeArea", "name": "Thames Valley" }
  ],
  "email": "hello@seoreading.uk",
  "sameAs": []
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const schema = [orgSchema, breadcrumbSchema, faqSchema];
---

<Base title={title} description={description} schema={schema}>

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden bg-brand min-h-[85vh] flex items-center" aria-labelledby="hero-heading">
    <!-- Aurora blobs -->
    <div class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full opacity-20 blur-[100px] aurora-1" style="background: radial-gradient(circle, #1B3A5C, transparent 70%);" aria-hidden="true"></div>
    <div class="absolute -bottom-32 -right-32 w-[400px] h-[400px] rounded-full opacity-15 blur-[90px] aurora-2" style="background: radial-gradient(circle, #D4AF37, transparent 70%);" aria-hidden="true"></div>
    <!-- Dot grid -->
    <div class="absolute inset-0 dot-grid-light" aria-hidden="true"></div>
    <!-- Noise texture -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.025] pointer-events-none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
      <rect width="100%" height="100%" filter="url(#grain)"/>
    </svg>

    <div class="relative z-10 max-w-6xl mx-auto px-5 py-20 md:py-28">
      <div class="max-w-3xl">
        <p class="text-accent text-sm font-semibold tracking-[0.15em] uppercase mb-4 fade-up">SEO Consultancy in Reading, Berkshire</p>
        <h1 id="hero-heading" class="text-white font-bold leading-[1.08] tracking-tight mb-6 fade-up" style="font-family: var(--font-serif); font-size: clamp(2.25rem, 6vw, 3.75rem); transition-delay: 80ms;">
          Grow your Reading business through
          <span class="bg-gradient-to-r from-accent via-accent-light to-accent bg-clip-text text-transparent">search that converts</span>
        </h1>
        <p class="text-gray-300 text-lg md:text-xl leading-relaxed max-w-2xl mb-8 fade-up" style="transition-delay: 160ms;">
          We help Thames Valley businesses rank in Google, dominate the local pack, and earn citations from ChatGPT, Perplexity, and AI Overviews. Senior-level strategy. Thames Valley pricing.
        </p>
        <div class="flex flex-wrap gap-4 fade-up" style="transition-delay: 240ms;">
          <a href="/free-seo-audit-reading/" class="btn btn-primary text-base py-3.5 px-7 relative overflow-hidden">
            <span class="relative z-10">Get Your Free Audit</span>
            <span class="shimmer absolute inset-0 bg-gradient-to-r from-transparent via-white/25 to-transparent -translate-x-full"></span>
          </a>
          <a href="/case-studies/" class="btn btn-outline border-white/30 text-white hover:bg-white/10 hover:border-white/50 py-3.5 px-7">View Results</a>
        </div>
      </div>

      <!-- Growth chart SVG -->
      <div class="absolute right-0 bottom-0 w-[45%] h-[60%] hidden lg:block pointer-events-none" aria-hidden="true">
        <svg viewBox="0 0 400 250" class="w-full h-full fade-up" style="transition-delay: 400ms;" preserveAspectRatio="xMaxYMax meet">
          <defs>
            <linearGradient id="goldGradient" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#D4AF37" stop-opacity="0.3"/>
              <stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <path class="growth-fill" d="M40,200 L80,185 L120,175 L160,160 L200,140 L240,110 L280,80 L320,55 L360,30 L360,200 Z"/>
          <path class="growth-line" d="M40,200 L80,185 L120,175 L160,160 L200,140 L240,110 L280,80 L320,55 L360,30"/>
          <!-- Data points -->
          <circle cx="200" cy="140" r="4" fill="#D4AF37" opacity="0.6"/>
          <circle cx="280" cy="80" r="4" fill="#D4AF37" opacity="0.7"/>
          <circle cx="360" cy="30" r="5" fill="#D4AF37" opacity="0.9"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST BAR ═══ -->
  <section class="bg-white border-b border-border/40 py-6" aria-label="Key metrics">
    <div class="max-w-6xl mx-auto px-5">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div class="fade-up" style="--i: 0">
          <p class="stat-value">Free</p>
          <p class="stat-label">Initial SEO health check</p>
        </div>
        <div class="fade-up stagger-child" style="--i: 1">
          <p class="stat-value">48hr</p>
          <p class="stat-label">Free audit turnaround</p>
        </div>
        <div class="fade-up stagger-child" style="--i: 2">
          <p class="stat-value" data-count="10" data-suffix="+">0+</p>
          <p class="stat-label">Reading areas covered</p>
        </div>
        <div class="fade-up stagger-child" style="--i: 3">
          <p class="stat-value" data-count="6" data-prefix="" data-suffix="">0</p>
          <p class="stat-label">Core SEO services</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INTRO + WHY READING NEEDS SEO ═══ -->
  <section class="py-16 md:py-24 relative" aria-labelledby="intro-heading">
    <div class="absolute inset-0 dot-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 id="intro-heading" class="font-bold text-brand mb-4 fade-up" style="font-family: var(--font-serif); font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: -0.02em;">Why Reading Businesses Need Local SEO</h2>
        <div class="gold-rule-center fade-up" style="transition-delay: 80ms;"></div>
        <p class="text-text-muted text-lg leading-relaxed mt-6 fade-up" style="transition-delay: 160ms;">Reading is one of the most commercially vibrant towns in the South East. Forbury Square houses major professional services firms. Green Park and Thames Valley Park accommodate corporate headquarters. This density means competition for local search visibility is exceptionally fierce.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card fade-up stagger-child" style="--i: 0">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2" style="font-family: var(--font-serif);">Map Pack Dominance</h3>
          <p class="text-text-muted text-[0.95rem] leading-relaxed">Google Business Profile results appear above organic listings for virtually every local query. If your business is not in the top three, those prospective clients proceed directly to a competitor.</p>
        </div>
        <div class="card fade-up stagger-child" style="--i: 1">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2" style="font-family: var(--font-serif);">Multi-Area Reach</h3>
          <p class="text-text-muted text-[0.95rem] leading-relaxed">Reading's catchment spans Caversham, Tilehurst, Earley, Woodley, Wokingham, and Bracknell. A properly structured campaign captures demand across all areas from a single website.</p>
        </div>
        <div class="card fade-up stagger-child" style="--i: 2">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2" style="font-family: var(--font-serif);">AI Search Ready</h3>
          <p class="text-text-muted text-[0.95rem] leading-relaxed">ChatGPT, Perplexity, and Google AI Overviews now answer commercial queries directly. If AI systems do not cite your business, you forfeit visibility even where traditional rankings remain strong.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES BENTO GRID ═══ -->
  <section class="py-16 md:py-24 bg-white relative" aria-labelledby="services-heading">
    <div class="max-w-6xl mx-auto px-5">
      <div class="text-center mb-12">
        <h2 id="services-heading" class="font-bold text-brand mb-4 fade-up" style="font-family: var(--font-serif); font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: -0.02em;">Our SEO Services for Reading Businesses</h2>
        <div class="gold-rule-center fade-up" style="transition-delay: 80ms;"></div>
        <p class="text-text-muted text-lg mt-6 max-w-2xl mx-auto fade-up" style="transition-delay: 160ms;">Every service is built around measurable outcomes: improved rankings, increased traffic, and a greater volume of qualified leads.</p>
      </div>

      <!-- Bento: 2-col asymmetric on md, 3-col on lg -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Local SEO, featured, spans 2 on lg -->
        <a href="/services/" class="group lg:col-span-2 card p-0 overflow-hidden flex flex-col md:flex-row no-underline fade-up" style="--i: 0">
          <div class="flex-1 p-7">
            <span class="inline-block text-[0.7rem] font-semibold text-accent tracking-[0.1em] uppercase mb-3">Core Service</span>
            <h3 class="font-bold text-brand text-xl mb-3 group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">Local SEO</h3>
            <p class="text-text-muted text-[0.95rem] leading-relaxed mb-4">Google Business Profile optimisation, local citation building, review strategy, and on-page optimisation for location-specific keywords across Reading and the Thames Valley.</p>
            <span class="text-accent text-sm font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">View services <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
          </div>
          <!-- Mini growth chart -->
          <div class="hidden md:flex items-end justify-center w-48 p-6 bg-brand/[0.03]">
            <svg viewBox="0 0 120 80" class="w-full opacity-60 group-hover:opacity-100 transition-opacity">
              <defs><linearGradient id="localFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#D4AF37" stop-opacity="0.2"/><stop offset="100%" stop-color="#D4AF37" stop-opacity="0"/></linearGradient></defs>
              <path d="M10,65 Q30,60 45,50 T80,25 L110,10 L110,70 L10,70 Z" fill="url(#localFill)"/>
              <path d="M10,65 Q30,60 45,50 T80,25 L110,10" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
        </a>

        <!-- Technical SEO -->
        <a href="/technical-seo-reading/" class="group card no-underline fade-up stagger-child" style="--i: 1">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2 group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">Technical SEO</h3>
          <p class="text-text-muted text-sm leading-relaxed">Site speed, crawlability, schema markup, mobile experience. We audit and fix the infrastructure issues silently undermining your rankings.</p>
        </a>

        <!-- SEO Audits -->
        <a href="/seo-audit-reading/" class="group card no-underline fade-up stagger-child" style="--i: 2">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2 group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">SEO Audits</h3>
          <p class="text-text-muted text-sm leading-relaxed">Thorough technical health, content gap, backlink, and competitor analysis. Every recommendation is specific and actionable.</p>
        </a>

        <!-- AI Search -->
        <a href="/ai-search-optimisation-reading/" class="group card no-underline fade-up stagger-child" style="--i: 3">
          <div class="w-10 h-10 rounded-lg bg-brand/5 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <h3 class="font-semibold text-brand text-lg mb-2 group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">AI Search Optimisation</h3>
          <p class="text-text-muted text-sm leading-relaxed">Get cited by ChatGPT, Perplexity, Google AI Overviews, and Microsoft Copilot. Entity optimisation, structured data, and authoritative content.</p>
        </a>

        <!-- Content Strategy -->
        <a href="/services/" class="group lg:col-span-2 card p-0 overflow-hidden flex flex-col md:flex-row no-underline fade-up stagger-child" style="--i: 4">
          <div class="flex-1 p-7">
            <h3 class="font-bold text-brand text-xl mb-3 group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">Content Strategy</h3>
            <p class="text-text-muted text-[0.95rem] leading-relaxed mb-4">Keyword-researched service pages, location pages, FAQ content, and editorial pieces that collectively establish your site as the most relevant result. Grounded in verified search demand.</p>
            <span class="text-accent text-sm font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">Learn more <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
          </div>
          <div class="hidden md:flex items-center justify-center w-48 p-6 bg-brand/[0.03]">
            <svg viewBox="0 0 100 100" class="w-20 h-20 opacity-50 group-hover:opacity-80 transition-opacity">
              <rect x="10" y="60" width="15" height="30" rx="2" fill="#D4AF37" opacity="0.3"/>
              <rect x="30" y="45" width="15" height="45" rx="2" fill="#D4AF37" opacity="0.5"/>
              <rect x="50" y="30" width="15" height="60" rx="2" fill="#D4AF37" opacity="0.7"/>
              <rect x="70" y="10" width="15" height="80" rx="2" fill="#D4AF37" opacity="0.9"/>
            </svg>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ AREAS COVERED ═══ -->
  <section class="py-16 md:py-24 relative" aria-labelledby="areas-heading">
    <div class="absolute inset-0 dot-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <div class="text-center mb-12">
        <h2 id="areas-heading" class="font-bold text-brand mb-4 fade-up" style="font-family: var(--font-serif); font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: -0.02em;">Areas We Cover Across Berkshire</h2>
        <div class="gold-rule-center fade-up" style="transition-delay: 80ms;"></div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 fade-up" style="transition-delay: 160ms;">
        {[
          { name: 'Reading Centre', desc: 'Broad Street, Forbury Square, the station quarter' },
          { name: 'Caversham', desc: 'Including Caversham Heights and Emmer Green' },
          { name: 'Tilehurst', desc: 'West Reading residential area' },
          { name: 'Earley', desc: 'Near University of Reading campus' },
          { name: 'Woodley', desc: 'East Reading independent high street' },
          { name: 'Wokingham', desc: 'Affluent market town' },
          { name: 'Bracknell', desc: 'Tech and finance hub' },
          { name: 'Newbury', desc: 'West Berkshire, Vodafone HQ' },
          { name: 'Henley-on-Thames', desc: 'Premium services market' },
          { name: 'Maidenhead', desc: 'Eastern Berkshire corridor' },
        ].map(area => (
          <div class="group bg-white border border-border rounded-lg p-4 text-center transition-all duration-300 hover:border-accent hover:shadow-md hover:-translate-y-1 cursor-default">
            <p class="font-semibold text-brand text-sm group-hover:text-accent-dark transition-colors" style="font-family: var(--font-serif);">{area.name}</p>
            <p class="text-text-muted text-xs mt-1 leading-snug">{area.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8 fade-up">
        <a href="/areas/" class="btn btn-outline text-sm py-2.5 px-6">See all areas we cover</a>
      </div>
    </div>
  </section>

  <!-- ═══ INDUSTRIES ═══ -->
  <section class="py-16 md:py-24 bg-brand text-white relative overflow-hidden" aria-labelledby="industries-heading">
    <!-- Atmosphere -->
    <div class="absolute inset-0 dot-grid-light pointer-events-none" aria-hidden="true"></div>
    <div class="absolute -top-32 left-1/4 w-[400px] h-[400px] rounded-full opacity-10 blur-[100px] aurora-1" style="background: radial-gradient(circle, #D4AF37, transparent 70%);" aria-hidden="true"></div>

    <div class="max-w-6xl mx-auto px-5 relative z-10">
      <div class="text-center mb-12">
        <h2 id="industries-heading" class="font-bold text-white mb-4 fade-up" style="font-family: var(--font-serif); font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: -0.02em;">Industries We Specialise In</h2>
        <div class="mx-auto w-16 h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent fade-up" style="transition-delay: 80ms;"></div>
