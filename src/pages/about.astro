---
import Base from '../layouts/Base.astro';

const title = 'About Forbury SEO | Reading SEO Agency';
const description = 'Forbury SEO is a search consultancy based in Reading, Berkshire. We specialise in local SEO, technical SEO, and AI search optimisation for Thames Valley businesses.';

const faqItems = [
  {
    q: 'What qualifications does your team have?',
    a: 'Our consultants hold MBA qualifications alongside professional certifications in Google Analytics, Google Ads, and technical SEO. Beyond formal credentials, our track record of measurable ranking improvements for businesses across Reading and the wider Thames Valley speaks to the depth of our expertise. We maintain our edge through continuous testing, direct GSC data analysis, and hands-on work across dozens of live sites.'
  },
  {
    q: 'How long has Forbury SEO been operating?',
    a: 'Our team brings over eight years of professional SEO experience. During that time, we have managed campaigns for local Reading businesses, national brands, and everything in between. The industry has changed dramatically in that period — from keyword-driven tactics to entity-based search to AI citations — and we have adapted our methodology at every stage to remain effective.'
  },
  {
    q: 'Do you work with businesses outside Reading?',
    a: 'Yes. While Reading and Berkshire form our core focus, we work with businesses across the Thames Valley and nationally. We regularly serve clients in Wokingham, Bracknell, Henley-on-Thames, Newbury, and Maidenhead. For businesses outside the region, we offer remote SEO consultancy with the same data-driven approach that underpins all of our engagements.'
  },
  {
    q: 'What industries does Forbury SEO specialise in?',
    a: 'We work across multiple sectors including professional services (solicitors, accountants, financial advisers), trades and home services, healthcare, property, education, and technology companies. Reading\'s diverse economy has allowed us to build expertise across industries rather than narrowing to a single vertical. Our industries page provides further detail on sector-specific capabilities.'
  },
  {
    q: 'How quickly can you begin work on our site?',
    a: 'Most engagements commence within a week of the initial conversation. We begin with either a complimentary SEO check or a paid comprehensive audit, depending on the complexity of your requirements. From there, we agree priorities collaboratively and begin implementation immediately. There is no protracted onboarding process — you engage directly with the team delivering the work.'
  },
  {
    q: 'How do we get started?',
    a: 'The most straightforward route is to request a free SEO audit through our audit page. We will review your site, identify the most significant opportunities, and return with a clear recommendation. There is no obligation and no pressure. If the numbers make sense for both parties, we discuss next steps accordingly.'
  }
];

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Forbury SEO",
  "url": "https://seoreading.uk",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Reading",
    "addressRegion": "Berkshire",
    "addressCountry": "GB"
  },
  "sameAs": []
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://seoreading.uk/about/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

const schema = [orgSchema, breadcrumbSchema, faqSchema];
---

<Base title={title} description={description} schema={schema}>
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="prose">

      <nav aria-label="Breadcrumb" class="text-sm mb-8">
        <ol class="flex gap-2">
          <li><a href="/">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">About</li>
        </ol>
      </nav>

      <h1>About Forbury SEO — Search Consultancy in Reading</h1>

      <p>Forbury SEO is a specialist search consultancy based in Reading, Berkshire. We work with local businesses and national brands to improve their visibility in Google and AI-powered search engines, delivering measurable organic growth across the Thames Valley and beyond.</p>

      <div class="quick-answer">
        <p><strong>Quick answer:</strong> Forbury SEO is a Reading-based search consultancy that combines technical SEO expertise with deep knowledge of the Berkshire business landscape. We work with businesses from Caversham to Green Park, providing transparent, data-driven strategies that produce measurable results.</p>
      </div>

      <h2>Our Consultancy</h2>

      <p>We established Forbury SEO to provide Reading and Thames Valley businesses with the calibre of search consultancy that was previously available only through large London agencies — but with the local knowledge, direct engagement, and accountability that only a specialist practice can offer.</p>

      <p>Our core disciplines are <a href="/technical-seo-reading/">technical SEO</a>, local search optimisation, content strategy, and <a href="/ai-search-optimisation-reading/">AI search optimisation</a>. These are not marketing terms on a brochure; they represent the specific capabilities we apply to every campaign, each informed by data from Google Search Console, Ahrefs, and direct measurement. Moreover, we view these disciplines as interconnected — a technical fix that improves crawlability, for instance, compounds the effect of a well-executed content strategy.</p>

      <p>We understand the Reading business landscape because we operate within it. We recognise the distinction between the footfall-driven independent shops on Broad Street and the enterprise procurement cycles at Green Park and Thames Valley Park. That contextual understanding matters considerably when constructing an SEO strategy. A one-size-fits-all approach from a distant agency that has never set foot in Berkshire will, in our experience, miss the nuances that determine whether a campaign converts or stalls.</p>

      <p>Our approach is practical and results-focused. Every recommendation we make is tied to a measurable outcome — more impressions, improved rankings, higher click-through rates, or increased lead generation. We do not produce 60-page reports filled with jargon that gather dust on a shelf. We identify what will move the needle and execute it with precision.</p>

      <h2>Why We Focus on Reading</h2>

      <p>Reading is one of the UK's most competitive local markets for digital services. The town sits at an intersection of several forces that make SEO here genuinely challenging, and accordingly, genuinely rewarding when executed well.</p>

      <p>Reading is home to major technology employers — Microsoft, Oracle, Cisco, and dozens of scale-ups at Thames Valley Park and Green Park. These companies drive demand for sophisticated digital services, which pushes the standard higher for every business competing online in the area. Alongside these corporates sit thousands of SMEs: solicitors around Forbury Square, independent retailers on Harris Arcade and Broad Street, tradespeople serving Caversham, Earley, Tilehurst, and Woodley.</p>

      <p>The Elizabeth Line connection to London intensifies this competition further. Reading businesses now compete directly with London firms for digital visibility. A Wokingham accountancy practice is no longer competing solely with other local firms — it is competing with Paddington-based practices that now claim to serve the Thames Valley.</p>

      <p>Reading's distinct areas each possess their own search characteristics. Caversham maintains a village identity with localised search intent. Earley's residential market drives service-based queries. The legal and financial cluster around Forbury Square targets professional service keywords. Green Park's corporate campus generates B2B search demand. Each requires a fundamentally different approach, and we have developed the local expertise to address those differences effectively.</p>

      <p>We chose to specialise in Reading because generic SEO advice does not succeed here. A Caversham cafe and a Green Park SaaS company need fundamentally different strategies. Understanding those differences is what separates effective local SEO from wasted expenditure.</p>

      <h2>Our Approach to SEO</h2>

      <p>We follow five principles in every engagement. These are non-negotiable — they define how we operate.</p>

      <p><strong>Audit first.</strong> We never prescribe solutions before understanding the problem. Every engagement commences with a thorough assessment of your current position: technical health, content gaps, backlink profile, local signals, and competitor landscape. This audit shapes everything that follows.</p>

      <p><strong>Data-driven decisions.</strong> We do not guess, and we do not rely on intuition alone. Every recommendation is substantiated by Google Search Console data, Ahrefs analysis, or direct measurement. When we advise that a page requires rewriting, we can demonstrate the impression count, click-through rate, and ranking position that led to that conclusion. When we prioritise one keyword over another, the data justifies it.</p>

      <p><strong>Transparency.</strong> You see exactly what we are doing and why. We share access to all reporting tools and explain changes in plain language. There are no black boxes, no proprietary methods that we cannot articulate, and no unnecessary mystique. SEO is not magic — it is structured problem-solving with clear inputs and measurable outputs.</p>

      <p><strong>AI-forward.</strong> The search landscape is shifting from ten blue links to AI-generated answers. Google's AI Overviews, ChatGPT, Perplexity, and Microsoft Copilot are fundamentally changing how people discover businesses. We build this into every campaign as standard — preparing your content to be cited by AI systems, not merely ranked by traditional algorithms. In 2026, this is not an optional consideration.</p>

      <p><strong>No lock-in contracts.</strong> We do not bind clients into lengthy agreements. Our work should speak for itself month to month. If we are delivering results, you will wish to continue the engagement. If we are not, you should be free to discontinue. This arrangement keeps us accountable and ensures you are never paying for inertia.</p>

      <h2>Services We Provide</h2>

      <p>We offer a focused set of SEO services tailored specifically to Reading and Thames Valley businesses:</p>

      <ul>
        <li><a href="/technical-seo-reading/">Technical SEO</a> — site architecture, crawlability, Core Web Vitals, schema markup, and indexation fixes that give search engines a clean path to your content.</li>
        <li><a href="/seo-audit-reading/">SEO Audits</a> — comprehensive assessments that identify precisely where your site is underperforming and what to address first for maximum impact.</li>
        <li><a href="/ai-search-optimisation-reading/">AI Search Optimisation</a> — ensuring your business receives citations in AI-generated answers from ChatGPT, Perplexity, Google AI Overviews, and Copilot.</li>
        <li>Local SEO — Google Business Profile optimisation, local citation building, review management, and location-specific content strategy.</li>
        <li>Content Strategy — keyword-mapped editorial plans that target genuine search demand rather than vanity topics.</li>
      </ul>

      <p>Full pricing details are available on our <a href="/seo-pricing-reading/">SEO pricing page</a>. We also offer a <a href="/free-seo-audit-reading/">free SEO audit</a> as an initial starting point — no obligation, simply a clear picture of where you stand.</p>

      <h2>Areas We Cover</h2>

      <p>Our primary service area encompasses Reading and the surrounding towns. Within Reading, we work with businesses in the town centre, Caversham, Tilehurst, Earley, Woodley, Whitley, Calcot, and Shinfield.</p>

      <p>Across wider Berkshire and the Thames Valley, we serve clients in Wokingham, Bracknell, Henley-on-Thames, Newbury, and Maidenhead. We also work with UK-wide businesses that require a local SEO presence in the Reading area.</p>

      <p>See our <a href="/areas/">areas page</a> for location-specific information about SEO in your town.</p>

      <h2>Working with Us</h2>

      <p>When you engage Forbury SEO, you work directly with the consultants delivering your campaign — not an account manager relaying messages, and not a junior team member learning at your expense. We handle strategy, execution, and reporting personally. You receive direct access throughout the engagement.</p>

      <p>A typical engagement begins in one of two ways. Either you request a <a href="/free-seo-audit-reading/">free SEO audit</a> and we return with an honest assessment of your opportunities, or we commence with a paid comprehensive audit that maps out a full 6-to-12-month strategy. From there, most clients transition to a monthly retainer arrangement where we implement, monitor, and iterate continuously.</p>

      <p>We report monthly with clear metrics: ranking movements, traffic changes, click-through rate improvements, and conversion data where tracking is in place. We flag problems early and adjust strategy based on what the data indicates — not what we assumed three months prior.</p>

      <p>We are deliberately selective about the clients we take on. We maintain a limited roster at any given time to ensure each engagement receives proper attention. We will not accept your business if we do not believe we can deliver meaningful results. That assessment begins with the initial audit.</p>

      <p>Read about previous results on our <a href="/case-studies/">case studies page</a>.</p>

      <h2>Frequently Asked Questions</h2>

      {faqItems.map(item => (
        <div class="faq-item">
          <h3 class="faq-question">{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}

      <div class="cta-box">
        <h2>Ready to Improve Your Search Visibility?</h2>
        <p>Book a consultation to discuss what SEO can achieve for your Reading business. No jargon, no pressure — simply an honest assessment of your opportunities and a clear path forward.</p>
        <p><a href="/contact/">Book a consultation</a> or request a <a href="/free-seo-audit-reading/">free SEO audit</a> to get started.</p>
      </div>

    </div>
  </section>
</Base>
