---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleRail from '../components/ArticleRail.astro';

const railItems = [
  { key: 'seo audit', value: 'From £300, one-off' },
  { key: 'starter', value: '£500 per month' },
  { key: 'growth', value: '£1,000 per month' },
  { key: 'enterprise', value: '£2,000 per month' },
  { key: 'commitment', value: 'Initial three months, then rolling with 30 days&rsquo; notice' }
];

const faqs = [
  {
    q: "What is the minimum contract duration?",
    a: "We ask for an initial three-month commitment, because SEO needs that long to take measurable effect. After that, the agreement rolls monthly and you may cancel with 30 days' notice. Clients who continue do so because they observe results, not because a long contract obliges them to."
  },
  {
    q: "Do you guarantee first-page rankings?",
    a: "No reputable SEO provider can guarantee specific rankings, as Google's algorithm considers in excess of 200 factors. What we guarantee is transparent reporting, ethical practices, and a clear strategy tied to measurable KPIs such as organic traffic, leads, and revenue."
  },
  {
    q: "What is encompassed within the monthly retainer?",
    a: "Every retainer includes technical SEO monitoring, content creation, on-page optimisation, local SEO management, and regular reporting. The precise scope is determined by your tier. We additionally provide ad-hoc support for questions and prompt fixes."
  },
  {
    q: "When should results be expected?",
    a: "There is no reliable fixed timeline for SEO results. Timing depends on the site's starting position, competition, technical constraints, content, and authority. We establish a baseline and report observed changes without promising a ranking date."
  },
  {
    q: "How should I compare SEO consultancy fees?",
    a: "Compare the agreed deliverables, who will do the work, reporting, contract terms, and any additional costs. Our published prices set out the available scopes; we confirm the fit and fee with you before paid work begins."
  },
  {
    q: "Is it possible to switch tiers or cancel?",
    a: "Yes. You may upgrade, downgrade, or cancel with 30 days' notice. Should your business grow and require additional content or link building, we scale accordingly. If budgets contract, we scale down to safeguard the gains already secured."
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "https://seoreading.uk/seo-pricing-reading/#breadcrumb",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seoreading.uk/services/" },
    { "@type": "ListItem", "position": 3, "name": "SEO Pricing Reading", "item": "https://seoreading.uk/seo-pricing-reading/" }
  ]
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "SEO Pricing Reading | Transparent Costs",
  "description": "Transparent SEO pricing for Reading businesses. Monthly retainers from £500 and one-off audits from £300, with scope and deliverables shown clearly.",
  "url": "https://seoreading.uk/seo-pricing-reading/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Reading", "url": "https://seoreading.uk/" },
  "breadcrumb": { "@id": "https://seoreading.uk/seo-pricing-reading/#breadcrumb" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "SEO Services Reading",
  "provider": { "@id": "https://seoreading.uk/#organization" },
  "areaServed": { "@type": "City", "name": "Reading" },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "SEO Packages",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "Starter SEO Package",
        "priceSpecification": { "@type": "PriceSpecification", "price": "500", "priceCurrency": "GBP", "unitText": "MONTH" }
      },
      {
        "@type": "Offer",
        "name": "Growth SEO Package",
        "priceSpecification": { "@type": "PriceSpecification", "price": "1000", "priceCurrency": "GBP", "unitText": "MONTH" }
      },
      {
        "@type": "Offer",
        "name": "Enterprise SEO Package",
        "priceSpecification": { "@type": "PriceSpecification", "price": "2000", "priceCurrency": "GBP", "unitText": "MONTH" }
      }
    ]
  }
};

const schema = [breadcrumbSchema, webPageSchema, faqSchema, serviceSchema];
---

<Base
  title="SEO Pricing Reading | Transparent Costs"
  description="Transparent SEO pricing for Reading businesses. Monthly retainers from £500 and one-off audits from £300, with scope and deliverables shown clearly."
  schema={schema}
>
  <PageHeader
    title="SEO Pricing for Reading Businesses"
    subtitle="Transparent SEO pricing for Reading businesses. Tiered packages from one-off audits to monthly retainers."
    tag="Audits from £300 · retainers £500 to £2,000 per month"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Pricing' }]}
  >
    <a slot="actions" href="/free-seo-audit-reading/" class="btn btn-primary">Get your free audit</a>
    <a slot="actions" href="/contact/" class="btn btn-ghost-light">Book a consultation</a>
  </PageHeader>

  <section class="max-w-6xl mx-auto px-5 py-14">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
    <div class="lg:col-span-8">
    <div class="prose prose-flush fade-up">

      <p>SEO Reading publishes clear pricing for businesses in Reading and Berkshire. Each tier shows its scope, monthly deliverables, and intended fit so you can assess the likely commitment before arranging a call.</p>

      <p>Every business presents different objectives, competitive landscapes, and starting positions. A cafe on <strong>Broad Street</strong> competing for "brunch reading" requires a different investment than a law firm at <strong>Forbury Square</strong> targeting "commercial solicitors berkshire." The pricing below reflects that reality accordingly.</p>

      <div class="quick-answer">
        <strong>Quick answer:</strong> A paid SEO audit starts at £300. Monthly service tiers range from £500 to £2,000 and list their deliverables below; final scope and fees are agreed before paid work begins.
      </div>

      <p>We publish our prices so you can review the available scopes before getting in touch. The page sets out one-off service costs and monthly retainers; final scope and fees are agreed with you before paid work begins.</p>

      <h2>Pricing Tiers</h2>

    </div>

    <!-- Tiers read as a spec sheet: price and scope on one line, deliverables
         ruled beneath, so tiers can be compared row by row rather than by card. -->
    <div class="not-prose my-10 space-y-5">

      <div class="pricing-tier">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pb-4 border-b border-rule">
          <div>
            <p class="tag">Starter</p>
            <p class="text-2xl font-bold text-brand mt-1" style="font-family: var(--font-serif);">£500<span class="text-base font-normal text-text-muted"> per month</span></p>
          </div>
          <p class="text-sm text-text-muted">For small Reading businesses</p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-8 mt-4 text-[0.92rem]">
          <li class="border-b border-rule py-2">Monthly technical SEO monitoring</li>
          <li class="border-b border-rule py-2">2 optimised content pieces per month</li>
          <li class="border-b border-rule py-2">Local SEO management (Google Business Profile)</li>
          <li class="border-b border-rule py-2">Monthly performance report</li>
          <li class="border-b border-rule py-2">On-page optimisation for key pages</li>
          <li class="border-b border-rule py-2">Core Web Vitals monitoring</li>
        </ul>
        <p class="text-[0.82rem] text-text-muted mt-4"><strong class="text-brand">Best for:</strong> Cafes near Broad Street, independent shops, local tradespeople, new businesses establishing their first organic presence.</p>
      </div>

      <div class="pricing-tier featured">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pb-4 border-b border-rule">
          <div>
            <p class="tag">Growth</p>
            <p class="text-2xl font-bold text-brand mt-1" style="font-family: var(--font-serif);">£1,000<span class="text-base font-normal text-text-muted"> per month</span></p>
          </div>
          <p class="text-sm text-text-muted">For established Reading businesses</p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-8 mt-4 text-[0.92rem]">
          <li class="border-b border-rule py-2">Full technical SEO audit and ongoing fixes</li>
          <li class="border-b border-rule py-2">4 optimised content pieces per month</li>
          <li class="border-b border-rule py-2">Link building (outreach and digital PR)</li>
          <li class="border-b border-rule py-2">Local SEO management</li>
          <li class="border-b border-rule py-2">Competitor tracking and gap analysis</li>
          <li class="border-b border-rule py-2">Fortnightly reporting with strategy calls</li>
          <li class="border-b border-rule py-2">Schema markup implementation</li>
        </ul>
        <p class="text-[0.82rem] text-text-muted mt-4"><strong class="text-brand">Best for:</strong> Estate agents, accountancy firms, law firms at Forbury Square, dental practices, and established service businesses positioned for growth.</p>
      </div>

      <div class="pricing-tier">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 pb-4 border-b border-rule">
          <div>
            <p class="tag">Enterprise</p>
            <p class="text-2xl font-bold text-brand mt-1" style="font-family: var(--font-serif);">£2,000<span class="text-base font-normal text-text-muted"> per month</span></p>
          </div>
          <p class="text-sm text-text-muted">For larger organisations and multi-location</p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-x-8 mt-4 text-[0.92rem]">
          <li class="border-b border-rule py-2">Everything in Growth, plus:</li>
          <li class="border-b border-rule py-2">AI search optimisation (ChatGPT, Copilot, Perplexity)</li>
          <li class="border-b border-rule py-2">Advanced schema and entity strategy</li>
          <li class="border-b border-rule py-2">Weekly reporting with priority Slack or email support</li>
          <li class="border-b border-rule py-2">Dedicated SEO strategist</li>
          <li class="border-b border-rule py-2">Multi-location or multi-service campaign management</li>
          <li class="border-b border-rule py-2">Conversion rate optimisation recommendations</li>
        </ul>
        <p class="text-[0.82rem] text-text-muted mt-4"><strong class="text-brand">Best for:</strong> Companies at Green Park, Thames Valley Park, multi-branch businesses, and organisations targeting national terms alongside local.</p>
      </div>

    </div>

    <div class="prose prose-flush">

      <p>All tiers include direct access to a senior SEO consultant, no junior account managers, no intermediaries. You communicate with the individual conducting the work.</p>

      <h2>One-Off Services</h2>

      <p>Not every business requires a monthly retainer. Should you need a specific piece of work completed, these one-off services address the most common requests we receive from Reading businesses.</p>

      <table>
        <thead>
          <tr>
            <th>Service</th>
            <th>Starting Price</th>
            <th>What You Receive</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><a href="/seo-audit-reading/">SEO Audit</a></td>
            <td>£300</td>
            <td>Full technical, on-page, and competitive audit with prioritised action plan</td>
          </tr>
          <tr>
            <td><a href="/technical-seo-reading/">Technical SEO Fix</a></td>
            <td>£500</td>
            <td>Hands-on implementation: crawl errors, Core Web Vitals, indexation issues, site speed</td>
          </tr>
          <tr>
            <td>Content Strategy</td>
            <td>£400</td>
            <td>Keyword research, topical mapping, content calendar, competitor gap analysis</td>
          </tr>
          <tr>
            <td><a href="/ai-search-optimisation-reading/">AI Search Optimisation Setup</a></td>
            <td>£750</td>
            <td>Entity optimisation, structured data, llms.txt, citation-ready content restructuring</td>
          </tr>
        </tbody>
      </table>

      <p>One-off services are typically delivered within 5-10 working days. Payment terms are 50% upfront and 50% upon delivery.</p>

      <h2>How to Compare SEO Proposals</h2>

      <p>Ask each provider to define the work included, who will deliver it, how progress will be reported, and what happens if priorities change. Compare like-for-like scopes and contract terms before choosing a provider.</p>

      <h2>What Affects SEO Pricing</h2>

      <p>No two SEO campaigns carry the same cost. Four factors drive price variation for Reading businesses:</p>

      <h3>1. Competition Level</h3>

      <p>A plumber in Tilehurst faces less online competition than a personal injury solicitor in Reading town centre. Greater competition necessitates more content, more link building, and more time to achieve rankings. Competitive verticals such as law, finance, and property in Reading typically require the Growth or Enterprise tier.</p>

      <h3>2. Current Site State</h3>

      <p>A newly launched website with no domain authority requires foundational work before it can compete. An established site with existing rankings may only need technical fixes and content gaps addressed. We assess this during the <a href="/seo-audit-reading/">initial audit</a> and recommend a tier based upon what your site genuinely requires, not what generates the greatest fee for us.</p>

      <h3>3. Goals and Timeline</h3>

      <p>A lower-competition local query may move sooner than a competitive property or legal term, but no fixed timeline applies to every site. We set expectations after reviewing the current rankings, technical condition, content, authority, and competitors.</p>

      <h3>4. Industry Regulations</h3>

      <p>YMYL (Your Money or Your Life) sectors (health, finance, legal) face more stringent quality thresholds in Google. A financial adviser in Reading requires E-E-A-T signals (credentials, authoritative content, trust markers) that a florist does not. This additional content and authority-building work is reflected in the pricing accordingly.</p>

      <h2>ROI of SEO for Reading Businesses</h2>

      <p>SEO is an investment, and you can model your own numbers with our free <a href="/tools/seo-roi-calculator/">SEO ROI calculator</a>. The following worked example illustrates how to consider the return. The figures are illustrative estimates drawn from typical keyword-tool averages and industry click-through data, not a projection or guarantee for any specific business.</p>

      <p><strong>Example: a Reading estate agent.</strong> The keyword "estate agents reading" generates approximately 1,300 searches per month. Position 1 captures roughly 28% of clicks; that equates to 364 visitors per month. The Google Ads equivalent cost for those clicks is approximately £2.50 per click, yielding a traffic value of <strong>£910 per month</strong> from a single keyword.</p>

      <p>At our Growth tier (£1,000/month), that worked example would put one commercially valuable query close to covering the monthly investment. A real campaign targets a connected group of terms, but actual return depends on rankings, click-through rate, conversion rate, customer value, competition, and starting position.</p>

      <p>Unlike PPC, SEO traffic does not cease when you stop investing. Rankings established over 12 months continue to generate traffic even if you pause your campaign. That residual value is what renders SEO the highest-ROI marketing channel for most Reading businesses.</p>

      <p>Local service businesses realise particularly strong returns because local search intent converts at substantially higher rates than generic informational searches. An individual searching "emergency plumber reading" is prepared to purchase immediately.</p>

      <h2>Frequently Asked Questions</h2>

      {faqs.map(f => (
        <div class="faq-item">
          <h3 class="faq-question">{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}

      <div class="cta-box">
        <h2>Request Your Free SEO Audit</h2>
        <p class="mt-2">Discover precisely where your Reading business stands in search. No obligation, no jargon, simply a clear report detailing what is working, what is not, and what to address first.</p>
        <a href="/free-seo-audit-reading/">Get your free audit</a>
      </div>

      <p class="text-sm text-text-muted">Prepared to discuss your SEO requirements? <a href="/contact/">Get in touch</a> or explore our full range of <a href="/services/">SEO services</a> for Reading businesses.</p>

    </div>
    </div>

      <div class="lg:col-span-4">
        <ArticleRail
          heading="Published prices"
          items={railItems}
          primaryHref="/free-seo-audit-reading/"
          primaryLabel="Get your free audit"
          secondaryHref="/contact/"
          secondaryLabel="Book a consultation"
          note="Final scope and fees are agreed with you before paid work begins. No ranking guarantees are offered."
        />
      </div>
    </div>
  </section>
</Base>
