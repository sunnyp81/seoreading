---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | SEO Reading" description="The page you are looking for does not exist. Return to the SEO Reading homepage for local SEO services in Reading, Berkshire.">
  <section class="max-w-3xl mx-auto px-5 py-24">
    <p class="tag mb-3">Error 404</p>
    <h1 class="text-brand font-bold text-4xl leading-tight mb-4" style="font-family: var(--font-serif);">Page not found</h1>
    <p class="text-lg text-text-muted max-w-[52ch]">The page you are looking for does not exist or has been moved. The links below cover the most common reasons people arrive here.</p>
    <div class="gold-rule"></div>

    <dl class="evidence mt-8">
      <div class="evidence-row">
        <dt class="evidence-key">services</dt>
        <dd class="evidence-value"><a href="/services/">Technical SEO, audits, content, local, AI search</a></dd>
      </div>
      <div class="evidence-row">
        <dt class="evidence-key">pricing</dt>
        <dd class="evidence-value"><a href="/seo-pricing-reading/">Published audit and retainer pricing</a></dd>
      </div>
      <div class="evidence-row">
        <dt class="evidence-key">areas</dt>
        <dd class="evidence-value"><a href="/areas/">Reading, Berkshire, and the Thames Valley</a></dd>
      </div>
      <div class="evidence-row">
        <dt class="evidence-key">contact</dt>
        <dd class="evidence-value"><a href="/contact/">Book an online consultation</a></dd>
      </div>
    </dl>

    <div class="mt-8 flex flex-col sm:flex-row gap-3">
      <a href="/" class="btn btn-primary">Back to the homepage</a>
      <a href="/free-seo-audit-reading/" class="btn btn-outline">Get your free audit</a>
    </div>
  </section>
</Base>
