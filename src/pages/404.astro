---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | Forbury SEO" description="The page you are looking for does not exist. Return to the Forbury SEO homepage for local SEO services in Reading, Berkshire.">
  <section class="max-w-3xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-bold text-brand mb-4">Page Not Found</h1>
    <p class="text-lg text-text-muted mb-8">The page you're looking for doesn't exist or has been moved.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/" class="bg-brand text-white px-6 py-3 rounded-lg hover:bg-brand-light transition-colors font-medium">Back to Homepage</a>
      <a href="/contact/" class="border-2 border-brand text-brand px-6 py-3 rounded-lg hover:bg-brand hover:text-white transition-colors font-medium">Contact Us</a>
    </div>
  </section>
</Base>
