---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import EvidenceList from '../components/EvidenceList.astro';

const contactRows = [
  { key: 'email', value: '<a href="mailto:hello@seoreading.uk">hello@seoreading.uk</a>' },
  { key: 'response time', value: 'We aim to reply within one working day' },
  { key: 'meetings', value: 'Online by default. In-person in the Reading area by prior agreement; no walk-in office' },
  { key: 'based', value: 'Reading, Berkshire' },
  { key: 'coverage', value: 'Reading, Caversham, Tilehurst, Earley, Woodley, Wokingham, Bracknell, wider Thames Valley' }
];

const faqs = [
  {
    q: "How quickly does your team respond?",
    a: "We aim to reply within one working day. If you have not heard back after that, email hello@seoreading.uk directly."
  },
  {
    q: "Do you offer free consultations?",
    a: "Yes. Every new enquiry receives a complimentary initial consultation in which we review your current search visibility, discuss your objectives, and outline what an SEO campaign would entail for your business. There is no obligation and no pressure."
  },
  {
    q: "Can we meet in person in Reading?",
    a: "SEO Reading is remote-first. Consultations take place online. An in-person meeting in the Reading area may be arranged by prior agreement; there is no walk-in office."
  },
  {
    q: "What should we prepare before getting in touch?",
    a: "It is helpful to have your website URL to hand, a general idea of your target keywords or services, and any existing Google Analytics or Search Console access. If you have none of that prepared, there is no cause for concern; we can begin from scratch and conduct a thorough audit during the initial consultation."
  }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": "https://seoreading.uk/contact/#breadcrumb",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://seoreading.uk/contact/" }
  ]
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "SEO Reading",
  "url": "https://seoreading.uk",
  "email": "hello@seoreading.uk",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Reading",
    "addressRegion": "Berkshire",
    "addressCountry": "GB"
  },
  "sameAs": []
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Contact SEO Reading | Book a Consultation",
  "description": "Contact the remote-first SEO Reading consultancy serving Reading, Berkshire, and the Thames Valley. Discuss your search visibility online.",
  "url": "https://seoreading.uk/contact/",
  "isPartOf": { "@type": "WebSite", "name": "SEO Reading", "url": "https://seoreading.uk/" },
  "breadcrumb": { "@id": "https://seoreading.uk/contact/#breadcrumb" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Base
  title="Contact SEO Reading | Book a Consultation"
  description="Contact the remote-first SEO Reading consultancy serving Reading, Berkshire, and the Thames Valley. Discuss your search visibility online."
  schema={[breadcrumbSchema, webPageSchema, faqSchema]}
>
  <PageHeader
    title="Contact SEO Reading"
    subtitle="Remote-first SEO consultancy serving Reading, Berkshire, and the Thames Valley."
    tag="Reply within one working day · online consultations"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
  />

  <section class="max-w-6xl mx-auto px-5 py-14">
    <div class="prose fade-up">
      <p>SEO Reading is a remote-first consultancy serving Reading, Berkshire, and the Thames Valley. Send your website and a short note about your goals; Sunny Patel will review the enquiry and reply within one working day.</p>

      <div class="quick-answer">
        <p>Book an online consultation with SEO Reading to discuss your search visibility. There is no walk-in office; in-person meetings in the Reading area may be arranged by prior agreement.</p>
      </div>

      <div id="form-confirmation" data-form-confirmation hidden class="not-prose my-6 p-5 border border-border border-l-[3px] border-l-accent bg-paper" role="status" aria-live="polite">
        <p class="font-semibold text-brand">Thank you, your message has been sent.</p>
        <p class="text-sm text-text-muted mt-1">We will reply within one working day. If it is urgent, email <a href="mailto:hello@seoreading.uk" class="underline">hello@seoreading.uk</a> directly.</p>
      </div>

    </div>

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 my-12">
        <div class="lg:col-span-7">
          <h2 class="text-xl font-bold text-brand mb-1" style="font-family: var(--font-serif);">Send a message</h2>
          <p class="text-sm text-text-muted mb-6">Name, email, and a short message are all we need to start.</p>
          <form action="https://emailit-worker.sunnypat81.workers.dev/" method="POST" class="space-y-5">
            <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
            <input type="hidden" name="_site" value="seoreading.uk" />
            <input type="hidden" name="subject" value="SEO Reading: New Enquiry (seoreading.uk)" />
            <input type="hidden" name="redirectTo" value="https://seoreading.uk/contact/?sent=1&amp;form=contact" />
            <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field blank" />
            <div>
              <label for="name" class="form-label">Name <span class="text-accent-ink">(required)</span></label>
              <input type="text" id="name" name="name" required class="form-input" placeholder="Your name" />
            </div>
            <div>
              <label for="email" class="form-label">Email <span class="text-accent-ink">(required)</span></label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="you@example.com" />
            </div>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="phone" class="form-label">Phone (optional)</label>
                <input type="tel" id="phone" name="phone" class="form-input" placeholder="07xxx xxxxxx" />
              </div>
              <div>
                <label for="website" class="form-label">Website URL (optional)</label>
                <input type="url" id="website" name="website" class="form-input" placeholder="https://yoursite.co.uk" />
              </div>
            </div>
            <div>
              <label for="message" class="form-label">Message <span class="text-accent-ink">(required)</span></label>
              <textarea id="message" name="message" rows="5" required class="form-input resize-y" placeholder="Tell us about your business and what you need help with"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full sm:w-auto">Book a consultation</button>
            <p class="text-sm text-text-muted">We use your details only to respond to this enquiry. Read our <a href="/privacy/" class="text-brand underline decoration-accent underline-offset-4">privacy notice</a>.</p>
          </form>
        </div>

        <div class="lg:col-span-5">
          <h2 class="tag mb-4">Contact details</h2>
          <EvidenceList items={contactRows} />

          <div class="mt-8 border-t-2 border-brand pt-5">
            <p class="font-semibold text-brand" style="font-family: var(--font-serif);">Ready for a free audit?</p>
            <p class="text-[0.92rem] text-text-muted mt-1">Request a free SEO audit and we will show you where your site stands in Reading&rsquo;s search results.</p>
            <a href="/free-seo-audit-reading/" class="btn btn-primary mt-4 w-full">Get your free audit</a>
          </div>
        </div>
    </div>

    <div class="prose">

      <h2>Areas We Cover</h2>

      <p>Our service area includes Reading town centre, Caversham, Tilehurst, Earley, Lower Earley, Woodley, Whitley, Calcot, Shinfield, Wokingham, Bracknell, Henley-on-Thames, Newbury, and Maidenhead. Remote consultancy is also available to UK-wide businesses that need local SEO for a Reading presence. See our <a href="/areas/">areas covered</a> page for location-specific details.</p>

      <div class="not-prose my-8 border border-border border-l-[3px] border-l-accent bg-paper p-6">
        <h2 class="text-xl font-semibold text-brand" style="font-family: var(--font-serif);">How meetings work</h2>
        <p class="mt-2 text-text-muted">Consultations and reporting are online by default. In-person meetings in the Reading area can be arranged by prior agreement. SEO Reading does not have a walk-in office.</p>
        <a class="btn btn-outline mt-4" href="mailto:hello@seoreading.uk">Email Sunny Patel</a>
      </div>

      <h2>Frequently Asked Questions</h2>

      {faqs.map(faq => (
        <div class="faq-item">
          <h3 class="faq-question">{faq.q}</h3>
          <p>{faq.a}</p>
        </div>
      ))}

      <h2>Next Steps</h2>

      <p>Not certain where to begin? Browse our <a href="/services/">SEO services</a> to see what we offer, review our <a href="/seo-pricing-reading/">pricing</a> for transparent costs, or learn more <a href="/about/">about our consultancy</a> and how we work with Reading businesses. Every engagement begins with a conversation, no templates, no generic proposals. We listen first, then construct a strategy that fits your market and budget.</p>
    </div>
  </section>

</Base>
