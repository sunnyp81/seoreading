      "@type": "Offer",
      "priceCurrency": "GBP",
      "price": "500",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "500",
        "priceCurrency": "GBP",
        "unitText": "MONTH",
        "minPrice": "500",
        "maxPrice": "2000"
      },
