    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seoreading.uk/services/" },
      { "@type": "ListItem", "position": 3, "name": "AI Search Optimisation Reading", "item": "https://seoreading.uk/ai-search-optimisation-reading/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": "https://seoreading.uk/ai-search-optimisation-reading/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Reading", "url": "https://seoreading.uk/" },
    "breadcrumb": { "@id": "https://seoreading.uk/ai-search-optimisation-reading/#breadcrumb" },
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".quick-answer"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "AI Search Optimisation Reading",
    "description": "AI search optimisation services for Reading and Berkshire businesses. Get cited by ChatGPT, Perplexity, Claude, Microsoft Copilot, and Google AI Overviews.",
    "provider": {
      "@type": "LocalBusiness",
      "name": "SEO Reading",
      "url": "https://seoreading.uk/",
      "areaServed": { "@type": "City", "name": "Reading", "containedInPlace": { "@type": "AdministrativeArea", "name": "Berkshire" } }
    },
    "serviceType": "AI Search Optimisation",
    "areaServed": [
      { "@type": "City", "name": "Reading" },
      { "@type": "AdministrativeArea", "name": "Berkshire" },
      { "@type": "AdministrativeArea", "name": "Thames Valley" }
    ],
