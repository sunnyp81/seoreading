---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ArticleRail from '../components/ArticleRail.astro';

// Mirrors the five checks described in the body copy below.
const checkRows = [
  { key: 'indexation', value: 'How many of your pages Google holds, and what is missing' },
  { key: 'core web vitals', value: 'LCP, INP, and CLS against Google&rsquo;s thresholds' },
  { key: 'local signals', value: 'Google Business Profile setup and NAP consistency' },
  { key: 'query snapshot', value: 'Queries you already appear for, and at what positions' },
  { key: 'priority action', value: 'The single highest-impact change to make first' }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://seoreading.uk/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://seoreading.uk/services/" },
      { "@type": "ListItem", "position": 3, "name": "Free SEO Audit Reading", "item": "https://seoreading.uk/free-seo-audit-reading/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Free SEO Audit Reading | Quick Check",
    "description": "Get a free SEO health check for your Reading business. Discover how your site performs in Google and what quick wins are available. No obligation.",
    "url": "https://seoreading.uk/free-seo-audit-reading/",
    "isPartOf": { "@type": "WebSite", "name": "SEO Reading", "url": "https://seoreading.uk/" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is the free SEO audit genuinely complimentary?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. The free SEO health check is provided at no cost and with no obligation. You receive a baseline report covering indexation, Core Web Vitals, local SEO presence, a top keyword snapshot, and one key recommendation. No credit card is required and there is no automatic enrolment in any paid service." }
      },
      {
        "@type": "Question",
        "name": "When will you respond to my free audit request?",
        "acceptedAnswer": { "@type": "Answer", "text": "We aim to reply within one working day. After reviewing the request, we will confirm whether the free health check is a fit and agree the expected report delivery time." }
      },
      {
        "@type": "Question",
        "name": "How does the free audit differ from the comprehensive paid audit?",
        "acceptedAnswer": { "@type": "Answer", "text": "The free audit comprises a 5-point health check. The comprehensive paid audit covers 50+ checkpoints across technical health, content gaps, backlink profile, local SEO, and competitor analysis, accompanied by a full prioritised action plan and a one-hour walkthrough call. Refer to the comparison table above for the complete breakdown." }
      },
      {
        "@type": "Question",
        "name": "Is the audit restricted to Reading businesses?",
        "acceptedAnswer": { "@type": "Answer", "text": "The free audit is available to any business; however, our local SEO analysis is most detailed for businesses in Reading, Berkshire, and the Thames Valley. We examine Reading-specific local signals including Google Business Profile optimisation, local directory presence, and local pack eligibility for your area." }
      }
    ]
  }
];
---

<Base title="Free SEO Audit Reading | Quick Check" description="Get a free SEO health check for your Reading business. Discover how your site performs in Google and what quick wins are available. No obligation." schema={schema}>
  <PageHeader
    title="Free SEO Audit for Reading Businesses"
    subtitle="Complimentary SEO health check for Reading businesses. Five checks, one priority action, no obligation."
    tag="Reply within one working day · no credit card"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services/' }, { label: 'Free SEO audit' }]}
  >
    <a slot="actions" href="#audit-request" class="btn btn-primary">Request the check</a>
    <a slot="actions" href="/seo-pricing-reading/" class="btn btn-ghost-light">See SEO pricing</a>
  </PageHeader>

  <section class="max-w-6xl mx-auto px-5 py-14">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
    <div class="lg:col-span-8">
    <div class="prose prose-flush fade-up">

      <p>SEO Reading provides a complimentary SEO health check for businesses in Reading and Berkshire. Submit your website URL and we will reply within one working day to confirm whether the five-point check is a fit and when we can send it.</p>

      <div class="quick-answer">
        <strong>Quick answer:</strong> The free SEO audit checks indexation, Core Web Vitals, local SEO presence, a top keyword snapshot, and one key recommendation. We aim to reply within one working day and confirm the report delivery time after reviewing your request. There is no obligation or credit card requirement.
      </div>

      <div id="form-confirmation" data-form-confirmation hidden class="not-prose my-6 p-5 border border-border border-l-[3px] border-l-accent bg-paper" role="status" aria-live="polite">
        <p class="font-semibold text-brand">Thank you, your free audit request has been received.</p>
        <p class="text-sm text-text-muted mt-1">We will review your request and reply within one working day to confirm the expected report delivery time. For questions, email <a href="mailto:hello@seoreading.uk" class="underline">hello@seoreading.uk</a>.</p>
      </div>

      <div class="not-prose my-8">
        <h2 class="tag mb-4">The five checks</h2>
        <dl class="evidence">
          {checkRows.map((row) => (
            <div class="evidence-row">
              <dt class="evidence-key">{row.key}</dt>
              <dd class="evidence-value" set:html={row.value} />
            </div>
          ))}
        </dl>
      </div>

      <form id="audit-request" action="https://emailit-worker.sunnypat81.workers.dev/" method="POST" class="not-prose bg-paper border border-border border-t-2 border-t-accent p-6 md:p-8 my-8">
        <input type="hidden" name="accessKey" value="sf_9e906eb6c00416b9d3354749" />
        <input type="hidden" name="_site" value="seoreading.uk" />
        <input type="hidden" name="subject" value="SEO Reading: Free Audit Request (seoreading.uk)" />
        <input type="hidden" name="redirectTo" value="https://seoreading.uk/free-seo-audit-reading/?sent=1&amp;form=free-audit" />
        <input type="text" name="honeypot" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" aria-label="Leave this field blank" />
        <h2 class="text-xl font-bold text-brand mb-1" style="font-family: var(--font-serif);">Request your free SEO health check</h2>
        <p class="text-sm text-text-muted mb-6">Fields marked required are the minimum we need to run the check.</p>

        <div class="grid md:grid-cols-2 gap-5 mb-5">
          <div>
            <label for="business-name" class="form-label">Business name <span class="text-accent-ink">(required)</span></label>
            <input type="text" id="business-name" name="business_name" required class="form-input" placeholder="e.g. Smith &amp; Sons Plumbing" />
          </div>
          <div>
            <label for="website-url" class="form-label">Website URL <span class="text-accent-ink">(required)</span></label>
            <input type="url" id="website-url" name="website_url" required class="form-input" placeholder="https://example.co.uk" />
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-5 mb-5">
          <div>
            <label for="email" class="form-label">Email address <span class="text-accent-ink">(required)</span></label>
            <input type="email" id="email" name="email" required class="form-input" placeholder="you@business.co.uk" />
          </div>
          <div>
            <label for="phone" class="form-label">Phone (optional)</label>
            <input type="tel" id="phone" name="phone" class="form-input" placeholder="07xxx xxxxxx" />
          </div>
        </div>

        <div class="mb-6">
          <label for="message" class="form-label">Anything specific you would like examined? (optional)</label>
          <textarea id="message" name="message" rows="3" class="form-input resize-y" placeholder="e.g. We recently redesigned our site and traffic dropped..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-full md:w-auto">Submit free audit request</button>
        <p class="text-sm text-text-muted mt-4">No spam and no obligation. We aim to reply within one working day and confirm report timing after reviewing your request. We use your details as explained in our <a href="/privacy/" class="text-brand underline decoration-accent underline-offset-4">privacy notice</a>.</p>
      </form>

      <h2>What You Get in Your Free Audit</h2>

      <p>The free SEO health check encompasses five baseline assessments that provide a clear snapshot of your website's current search performance.</p>

      <ol>
        <li><strong>Indexation status</strong>: how many of your pages are present in Google's index, and are there pages missing or pages that ought not to be there?</li>
        <li><strong>Core Web Vitals</strong>: does your site satisfy Google's speed and user experience thresholds? We examine LCP, INP, and CLS from real-world data.</li>
        <li><strong>Local SEO presence</strong>: is your Google Business Profile established and optimised? Are your NAP details consistent across Reading directories?</li>
        <li><strong>Top keyword snapshot</strong>: which queries is your site currently appearing for in Google, and at what positions?</li>
        <li><strong>One key recommendation</strong>: the single highest-impact change you can implement immediately to improve your visibility within Reading search results.</li>
      </ol>

      <p>This is a focused health check rather than a comprehensive audit. It provides sufficient information to understand your baseline and determine whether a more thorough analysis merits consideration.</p>

      <h2>How It Works</h2>

      <h3>Step 1: Submit the Form</h3>

      <p>Complete the form above with your business name, website URL, and email address. Phone and message fields are optional, though they enable us to tailor the check to your particular circumstances. Businesses in <strong>Caversham</strong>, <strong>Earley</strong>, <strong>Tilehurst</strong>, <strong>Woodley</strong>, and across <strong>Reading</strong> are all welcome.</p>

      <h3>Step 2: Receive Your Report</h3>

      <p>We review each request and reply within one working day to confirm fit and expected delivery time. The report is sent by email as a concise PDF covering the five baseline checks, with a brief explanation of each finding.</p>

      <h3>Step 3: Optional Discussion Call</h3>

      <p>Should you wish to discuss the findings, we offer a complimentary 15-minute call to walk through the report and address questions. This is entirely optional and carries no sales pressure. In our experience, many Reading business owners find it valuable to have technical findings explained in practical, commercial terms.</p>

      <h2>Why We Offer a Free Audit</h2>

      <p>Every Reading business deserves to understand its position in Google. Many business owners are unaware of whether their site is indexed correctly, whether it meets Core Web Vitals thresholds, or whether their Google Business Profile is properly optimised. A complimentary baseline check provides that clarity.</p>

      <p>Moreover, we find that once business owners examine the data, the value of professional SEO becomes self-evident. The free audit is not a sales device; it is a genuine diagnostic upon which you may act independently or present to any SEO provider. Should you elect to engage us, the baseline data feeds directly into a comprehensive strategy.</p>

      <h2>Free vs Comprehensive Audit</h2>

      <table>
        <thead>
          <tr>
            <th>Feature</th>
            <th>Free Health Check</th>
            <th>Comprehensive Audit</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Indexation check</td>
            <td>Basic (indexed page count)</td>
            <td>Full crawl with issue identification</td>
          </tr>
          <tr>
            <td>Core Web Vitals</td>
            <td>Pass/fail summary</td>
            <td>Page-by-page analysis with fixes</td>
          </tr>
          <tr>
            <td>Local SEO</td>
            <td>GBP presence check</td>
            <td>Full local audit (GBP, citations, local pack, reviews)</td>
          </tr>
          <tr>
            <td>Keyword analysis</td>
            <td>Top 10 keyword snapshot</td>
            <td>Full keyword gap + striking distance analysis</td>
          </tr>
          <tr>
            <td>Content audit</td>
            <td>Not included</td>
            <td>Full content quality + cannibalisation review</td>
          </tr>
          <tr>
            <td>Backlink review</td>
            <td>Not included</td>
            <td>Full profile with toxic link identification</td>
          </tr>
          <tr>
            <td>Competitor analysis</td>
            <td>Not included</td>
            <td>3-5 competitor benchmark</td>
          </tr>
          <tr>
            <td>Action plan</td>
            <td>1 key recommendation</td>
            <td>Full prioritised action plan (30-60 pages)</td>
          </tr>
          <tr>
            <td>Walkthrough call</td>
            <td>Optional 15 minutes</td>
            <td>1-hour detailed walkthrough</td>
          </tr>
          <tr>
            <td>Delivery time</td>
            <td>Reply within one working day; report date confirmed after review</td>
            <td>7-14 working days</td>
          </tr>
          <tr>
            <td>Cost</td>
            <td>Free</td>
            <td>Fixed fee (<a href="/seo-pricing-reading/">see pricing</a>)</td>
          </tr>
        </tbody>
      </table>

      <p>The free health check is the appropriate starting point if you have not previously commissioned an SEO audit and wish to establish your baseline. The <a href="/seo-audit-reading/">comprehensive audit</a> is suited to businesses prepared to invest in a detailed strategy.</p>

      <h2>Frequently Asked Questions</h2>

      <div class="faq-item">
        <h3 class="faq-question">Is the free SEO audit genuinely complimentary?</h3>
        <p>Yes. The free SEO health check is provided at no cost and with no obligation. You receive a baseline report covering indexation, Core Web Vitals, local SEO presence, a top keyword snapshot, and one key recommendation. No credit card is required and there is no automatic enrolment in any paid service.</p>
      </div>

      <div class="faq-item">
          <h3 class="faq-question">When will you respond to my free audit request?</h3>
        <p>We aim to reply within one working day. After reviewing the request, we will confirm whether the free health check is a fit and agree the expected report delivery time.</p>
      </div>

      <div class="faq-item">
        <h3 class="faq-question">How does the free audit differ from the comprehensive paid audit?</h3>
        <p>The free audit comprises a 5-point health check. The <a href="/seo-audit-reading/">comprehensive paid audit</a> covers 50+ checkpoints across technical health, content gaps, backlink profile, local SEO, and competitor analysis, accompanied by a full prioritised action plan and a one-hour walkthrough call. Refer to the comparison table above for the complete breakdown.</p>
      </div>

      <div class="faq-item">
        <h3 class="faq-question">Is the audit restricted to Reading businesses?</h3>
        <p>The free audit is available to any business; however, our local SEO analysis is most detailed for businesses in Reading, Berkshire, and the Thames Valley. We examine Reading-specific local signals including Google Business Profile optimisation, local directory presence, and local pack eligibility for your area.</p>
      </div>

      <div class="cta-box">
        <h2>Considering a More Thorough Analysis?</h2>
        <p>The free health check establishes a baseline. Our comprehensive SEO audit delivers a complete strategy. This includes 50+ checkpoints, competitor benchmarking, and a prioritised action plan.</p>
        <a href="/seo-audit-reading/">See the comprehensive audit</a>
      </div>

      <p>Consult our <a href="/seo-pricing-reading/">pricing page</a> for audit and retainer costs. Back to <a href="/services/">all services</a> or return to our <a href="/">SEO consultancy in Reading overview</a>.</p>

    </div>
    </div>

      <div class="lg:col-span-4">
        <ArticleRail
          heading="What the free check covers"
          items={checkRows}
          primaryHref="#audit-request"
          primaryLabel="Request the check"
          secondaryHref="/seo-audit-reading/"
          secondaryLabel="Compare with the paid audit"
          note="Sent by email as a short PDF. No credit card, and no automatic enrolment in a paid service."
        />
      </div>
    </div>
  </section>

</Base>
