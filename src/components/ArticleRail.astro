---
import EvidenceList from './EvidenceList.astro';

interface Item {
  key: string;
  value: string;
}

interface Props {
  heading: string;
  items: Item[];
  primaryHref: string;
  primaryLabel: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  note?: string;
}

const { heading, items, primaryHref, primaryLabel, secondaryHref, secondaryLabel, note } = Astro.props;
---

<aside class="lg:sticky lg:top-24 border-t-2 border-brand pt-5" aria-label={heading}>
  <h2 class="tag mb-4">{heading}</h2>
  <EvidenceList items={items} />
  <div class="mt-6 flex flex-col gap-2">
    <a href={primaryHref} class="btn btn-primary w-full">{primaryLabel}</a>
    {secondaryHref && secondaryLabel && (
      <a href={secondaryHref} class="btn btn-outline w-full">{secondaryLabel}</a>
    )}
  </div>
  {note && <p class="mt-4 text-[0.82rem] leading-relaxed text-text-muted" set:html={note} />}
</aside>
